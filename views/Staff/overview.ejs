<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/stylesheets/styles.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <title>Översikt</title>
</head>

<body class="bg-[#f5f0eb]">
  <div class="flex">
    <div class="hidden md:block">
      <%- include("../Partials/sidebar-staff.ejs") %>
    </div>

    <div class="flex flex-1 flex-col">
      <%- include("../Partials/topbar-staff.ejs") %>

      <main class="p-4 md:p-8 pb-20 md:pb-8">

        <!-- Hälsning -->
        <h1 class="text-3xl font-bold">God morgon, Johan</h1>
        <p class="text-gray-400 mb-6"><%= dateString %></p>

        <!-- Statistik-kort -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          <div class="bg-green-100 rounded-2xl p-5 flex justify-between items-center">
            <div>
              <p class="text-xs font-bold uppercase text-gray-500 mb-2">Att göra idag</p>
              <p class="text-4xl font-bold"><%= todoCount %></p>
            </div>
            <div class="bg-green-200 rounded-full p-3">
              <i class="fa-solid fa-list-check text-green-600 text-xl"></i>
            </div>
          </div>
          <div class="bg-white rounded-2xl p-5 flex justify-between items-center">
            <div>
              <p class="text-xs font-bold uppercase text-gray-500 mb-2">Avklarade</p>
              <p class="text-4xl font-bold"><%= doneCount %></p>
            </div>
            <div class="bg-green-500 rounded-full p-3">
              <i class="fa-solid fa-check text-white text-xl"></i>
            </div>
          </div>
        </div>

        <!-- Dagens uppgifter -->
        <h2 class="text-xl font-bold mb-4">Dagens uppgifter</h2>

        <% Object.entries(grouped).forEach(([type, tasks]) => { %>
        <div class="mb-6">
          <p class="flex items-center gap-2 text-sm font-semibold mb-3">
            <span class="size-3 rounded-full bg-gray-800 inline-block"></span>
            <%= type %>
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <% tasks.forEach(task => { %>
            <div class="bg-white rounded-xl p-4 flex items-center justify-between <%= task.status === 'Klar' ? 'opacity-60' : '' %>">
              <div class="flex items-center gap-3">
                <% if (task.photoUrl) { %>
                <img src="<%= task.photoUrl %>" class="size-10 rounded-full object-cover" />
                <% } else { %>
                <div class="bg-gray-100 rounded-lg p-2">
                  <i class="fa-solid fa-list-check text-gray-500"></i>
                </div>
                <% } %>
                <div>
                  <p class="font-semibold"><%= task.horseName || task.title %></p>
                  <p class="text-xs text-gray-400"><%= task.location %></p>
                  <% if (task.instructions) { %>
                  <p class="text-xs text-gray-400 mt-1"><%= task.instructions %></p>
                  <% } %>
                </div>
              </div>
              <form action="/staff/overview/tasks/<%= task.id %>/<%= task.status === 'Klar' ? 'uncomplete' : 'complete' %>" method="POST">
                <input type="checkbox" 
                  class="size-5 accent-blue-500 cursor-pointer"
                  <%= task.status === 'Klar' ? 'checked' : '' %>
                  onchange="this.form.submit()" />
              </form>
            </div>
            <% }) %>
          </div>
        </div>
        <% }) %>

      </main>
    </div>
  </div>

  <%- include("../Partials/bottomnav-staff.ejs") %>
</body>
</html>