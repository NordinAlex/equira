<!DOCTYPE html>
<html lang="sv">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/stylesheets/styles.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <title>Uppgifter</title>
</head>

<body class="bg-[#f5f0eb]">
  <div class="flex">
    <div class="hidden md:block">
      <%- include("../Partials/sidebar-staff.ejs") %>
    </div>

    <div class="flex flex-1 flex-col">
      <%- include("../Partials/topbar-staff.ejs") %>

        <main class="p-4 md:p-8 pb-20 md:pb-8">

          <!-- Header -->
          <div class="flex items-center gap-3">
            <img src="/images/avatar.jpg" class="size-10 rounded-full object-cover" />
            <h1 class="text-2xl md:text-3xl font-bold">Dagens uppgifter</h1>
          </div>
          <div class="mb-6">
            <p class="text-gray-400">
              <%= dateString %>
            </p>
          </div>

          <!-- Filter-knappar -->
          <div class="flex gap-3 mb-6">
            <button class="bg-[#2c1a0e] text-white px-4 py-2 rounded-full text-sm font-semibold">Alla</button>
            <button class="border px-4 py-2 rounded-full text-sm font-semibold hover:bg-gray-100 bg-white">Mina</button>
            <button
              class="border px-4 py-2 rounded-full text-sm font-semibold hover:bg-gray-100 bg-white">Akuta</button>
            <button
              class="border px-4 py-2 rounded-full text-sm font-semibold hover:bg-gray-100 bg-white">Klara</button>
          </div>

          <!-- Aktuella uppgifter -->
          <h2 class="font-bold text-lg mb-4">Aktuella Uppgifter</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <% tasks.filter(t=> t.status !== 'Klar').forEach(task => { %>
              <div class="bg-white rounded-2xl p-5 shadow-sm">
                <div class="flex justify-between items-start mb-1">
                  <h3 class="font-bold text-lg">
                    <%= task.title %>
                  </h3>
                  <span class="text-xs border px-2 py-1 rounded-md
                <%= task.priority === 'Hög' ? 'text-yellow-600 bg-yellow-100 border-yellow-300' : 'text-gray-500' %>">
                    <%= task.priority?.toUpperCase() || 'NORMAL' %>
                  </span>
                </div>
                <p class="text-sm text-gray-400 mb-3">
                  <%= task.location %>
                </p>
                <% if (task.instructions) { %>
                  <p class="text-sm italic text-gray-600 mb-4">"<%= task.instructions %>"</p>
                  <% } %>
                    <div class="flex justify-between items-center text-sm text-gray-400 mb-4">
                      <span><i class="fa-regular fa-clock mr-1"></i>
                        <%= task.dueTime %> • <%= task.status %>
                      </span>
                    </div>
                    <form action="/staff/tasks/<%= task.id %>/complete" method="POST">
                      <button class="w-full bg-[#2c1a0e] text-white py-2 rounded-xl hover:bg-[#3d2512]">
                        <i class="fa-regular fa-circle-check mr-2"></i>Markera som klar
                      </button>
                    </form>
              </div>
              <% }) %>
          </div>

          <!-- Klara uppgifter -->
          <h2 class="font-bold text-lg mb-4 mt-10">Klara Uppgifter</h2>

          <div class="flex flex-col gap-3">
            <% tasks.filter(t=> t.status === 'Klar').forEach(task => { %>
              <div class="bg-white rounded-xl p-4 flex items-center justify-between border">
                <div class="flex items-center gap-4">
                  <div class="bg-green-100 rounded-full p-2">
                    <i class="fa-solid fa-check text-green-500"></i>
                  </div>
                  <div>
                    <p class="font-bold">
                      <%= task.title %>
                    </p>
                    <p class="text-sm text-gray-400">Klar <%= task.completedAt ? task.completedAt.substring(11, 16) : ''
                        %>
                    </p>
                  </div>
                </div>
                <form action="/staff/tasks/<%= task.id %>/uncomplete" method="POST">
                  <button class="border px-4 py-1 rounded-lg text-sm hover:bg-gray-100">Ångra</button>
                </form>
              </div>
              <% }) %>
          </div>

        </main>
    </div>
  </div>

  <%- include("../Partials/bottomnav-staff.ejs") %>
</body>

</html>