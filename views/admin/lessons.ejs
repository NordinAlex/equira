<div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto space-y-6 sm:space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <div class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Schema & Administration</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight mt-1">Lektioner</h2>
      <p class="text-xs sm:text-sm text-stone-500 mt-1 max-w-2xl">
        Hantera och schemalägg ridskolans lektionspass, grupper och instruktörsresurser med full kontroll över deltagare och hästfördelning.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin/lessons/create" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#3d2314] hover:bg-[#2c190e] text-white px-5 py-2.5 rounded-xl font-medium text-sm shadow-sm transition hover-lift">
        <i class="fa-solid fa-plus text-xs"></i>
        <span>Ny Lektion</span>
      </a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs rounded-xl flex items-center gap-2">
      <i class="fa-solid fa-circle-check text-emerald-500"></i>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl flex items-center gap-2">
      <i class="fa-solid fa-triangle-exclamation text-rose-500"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- KPI Cards Row (Matching PDF 3 page 4) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-stone-400 uppercase tracking-wider">Totalt lektioner</p>
        <p class="text-2xl font-black text-stone-900 mt-1"><%= data.kpis.totalLessons %> <span class="text-xs font-normal text-stone-500">pass</span></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-stone-100 flex items-center justify-center text-stone-600 shrink-0">
        <i class="fa-solid fa-book-open"></i>
      </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-stone-400 uppercase tracking-wider">Deltagare inskrivna</p>
        <p class="text-2xl font-black text-stone-900 mt-1"><%= data.kpis.totalBookings %> <span class="text-xs font-normal text-stone-500">/ <%= data.kpis.totalCapacity %></span></p>
        <p class="text-[10px] text-emerald-600 font-semibold mt-0.5"><%= data.kpis.fillPercentage %>% fyllnadsgrad</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 shrink-0">
        <i class="fa-solid fa-user-check"></i>
      </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-stone-400 uppercase tracking-wider">Aktiva instruktörer</p>
        <p class="text-2xl font-black text-stone-900 mt-1">4 <span class="text-xs font-normal text-stone-500">i tjänst</span></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-sky-50 flex items-center justify-center text-sky-600 shrink-0">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-amber-200 shadow-sm flex items-center justify-between <%= data.kpis.unassignedCount > 0 ? 'bg-amber-50/50' : '' %>">
      <div>
        <p class="text-[11px] font-bold text-amber-900 uppercase tracking-wider">Oklara hästtilldelningar</p>
        <p class="text-2xl font-black text-amber-700 mt-1"><%= data.kpis.unassignedCount %> <span class="text-xs font-normal text-amber-800">pass</span></p>
        <a href="/admin/assign" class="text-[10px] font-bold text-amber-800 underline hover:text-amber-950">Kräver tilldelning &rarr;</a>
      </div>
      <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center text-amber-700 shrink-0">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
    </div>
  </div>

  <!-- Lessons Table (Matching PDF 3 page 4) -->
  <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="p-4 border-b border-stone-100 flex flex-wrap items-center justify-between gap-4">
      <h3 class="text-sm font-bold text-stone-800">
        Schemalagda lektionspass <span class="text-stone-400 font-normal">(<%= data.lessons.length %> st)</span>
      </h3>
      <div class="flex items-center gap-2 text-xs">
        <a href="/admin/schedule" class="px-3 py-1.5 border border-stone-200 hover:bg-stone-50 rounded-lg text-stone-600 transition">
          <i class="fa-regular fa-calendar mr-1"></i> Veckoschema
        </a>
      </div>
    </div>

    <!-- Mobile Scroll Hint -->
    <div class="block sm:hidden px-4 py-2 bg-stone-50 border-b border-stone-100 text-[11px] text-stone-500 flex items-center gap-1.5">
      <i class="fa-solid fa-arrows-left-right text-stone-400"></i>
      <span>Svep i sidled för att se alla lektionsdetaljer</span>
    </div>

    <div class="overflow-x-auto touch-scroll">
      <table class="w-full text-left border-collapse text-xs min-w-[640px] md:min-w-full">
        <thead>
          <tr class="bg-stone-50 text-stone-500 font-bold uppercase tracking-wider border-b border-stone-200">
            <th class="py-3 px-3 sm:px-4">Lektion & Tid</th>
            <th class="py-3 px-3 sm:px-4">Instruktör</th>
            <th class="py-3 px-3 sm:px-4">Disciplin & Nivå</th>
            <th class="py-3 px-3 sm:px-4">Beläggning</th>
            <th class="py-3 px-3 sm:px-4">Hästtilldelning</th>
            <th class="py-3 px-3 sm:px-4">Status</th>
            <th class="py-3 px-3 sm:px-4 text-right">Åtgärd</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% data.lessons.forEach(l => { %>
            <tr class="hover:bg-stone-50/80 transition">
              <td class="py-3.5 px-3 sm:px-4">
                <a href="/admin/lessons/<%= l.id %>/edit" class="font-bold text-stone-900 text-sm hover:underline hover:text-[#4a2828] transition block">
                  <%= l.title %>
                </a>
                <div class="text-stone-400 text-[11px] mt-0.5 flex flex-wrap items-center gap-x-1.5 gap-y-0.5">
                  <span><%= l.date %></span>
                  <span class="text-stone-300">&bull;</span>
                  <span><%= l.time %></span>
                  <span class="text-stone-300">&bull;</span>
                  <span><%= l.arenaName %></span>
                </div>
              </td>

              <td class="py-3.5 px-3 sm:px-4 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded-full bg-stone-200 text-stone-700 flex items-center justify-center font-bold text-[10px] shrink-0">
                    <%= l.instructorName.charAt(0) %>
                  </div>
                  <span class="font-medium text-stone-800"><%= l.instructorName %></span>
                </div>
              </td>

              <td class="py-3.5 px-3 sm:px-4 whitespace-nowrap">
                <div class="inline-flex items-center gap-1.5 flex-wrap">
                  <span class="inline-block px-2 py-0.5 rounded bg-amber-50 text-amber-900 font-medium text-[10px] border border-amber-200 shrink-0">
                    <%= l.lessonType %>
                  </span>
                  <span class="text-stone-500"><%= l.level %></span>
                </div>
              </td>

              <td class="py-3.5 px-3 sm:px-4 whitespace-nowrap">
                <span class="font-semibold text-stone-800"><%= l.occupancyText %></span>
              </td>

              <td class="py-3.5 px-3 sm:px-4 whitespace-nowrap">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold border <%= l.allocationBadge.class %>">
                  <%= l.allocationBadge.label %>
                </span>
              </td>

              <td class="py-3.5 px-3 sm:px-4 whitespace-nowrap">
                <span class="inline-flex items-center gap-1.5 text-stone-600">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                  <%= l.status %>
                </span>
              </td>

              <td class="py-3.5 px-3 sm:px-4 text-right whitespace-nowrap">
                <div class="inline-flex items-center justify-end gap-1.5">
                  <a href="/admin/assign/<%= l.id %>" class="px-2.5 py-1.5 bg-[#4a2828] hover:bg-[#381e1e] text-white rounded-lg font-medium text-xs transition shadow-xs inline-flex items-center gap-1" title="Tilldela hästar">
                    <span>Tilldela</span>
                    <i class="fa-solid fa-chevron-right text-[9px]"></i>
                  </a>
                  <a href="/admin/lessons/<%= l.id %>/edit" class="p-1.5 text-stone-500 hover:text-stone-900 hover:bg-stone-100 rounded-lg transition" title="Redigera lektion">
                    <i class="fa-solid fa-pen text-xs"></i>
                  </a>
                  <button type="button" data-id="<%= l.id %>" data-title="<%= l.title %>" onclick="openGlobalDeleteModal(this.dataset.id, this.dataset.title)" class="p-1.5 text-stone-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition cursor-pointer" title="Ta bort lektion">
                    <i class="fa-regular fa-trash-can text-xs"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Global Delete Confirmation Modal -->
<div id="globalDeleteModal" onclick="if(event.target === this) closeGlobalDeleteModal()" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs hidden p-4">
  <div class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl border border-stone-200 space-y-4">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-xl shrink-0">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div>
        <h3 class="text-base font-bold text-stone-900">Ta bort lektion?</h3>
        <p class="text-xs text-stone-400">Denna åtgärd kan inte ångras</p>
      </div>
    </div>
    <p class="text-xs text-stone-600 leading-relaxed bg-stone-50 p-3 rounded-xl border border-stone-100">
      Är du säker på att du vill ta bort lektionspasset <strong class="text-stone-900" id="globalDeleteLessonTitle">lektionen</strong>? Alla kopplade elev- och hästbokningar raderas permanent.
    </p>
    <div class="flex items-center justify-end gap-2.5 pt-2">
      <button type="button" onclick="closeGlobalDeleteModal()" class="px-4 py-2 text-xs font-semibold text-stone-600 hover:bg-stone-100 rounded-xl transition cursor-pointer">
        Avbryt
      </button>
      <form id="globalDeleteLessonForm" action="" method="POST" class="inline m-0 p-0">
        <button type="submit" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold rounded-xl shadow-xs transition cursor-pointer flex items-center gap-1.5">
          <i class="fa-regular fa-trash-can"></i>
          <span>Ja, ta bort lektion</span>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  function openGlobalDeleteModal(id, title) {
    const modal = document.getElementById('globalDeleteModal');
    const titleEl = document.getElementById('globalDeleteLessonTitle');
    const form = document.getElementById('globalDeleteLessonForm');
    if (titleEl) titleEl.textContent = `"${title || 'lektionen'}"`;
    if (form) form.action = `/admin/lessons/${id}/delete`;
    if (modal) modal.classList.remove('hidden');
  }

  function closeGlobalDeleteModal() {
    const modal = document.getElementById('globalDeleteModal');
    if (modal) modal.classList.add('hidden');
  }

  function confirmDeleteLesson(id, title) {
    openGlobalDeleteModal(id, title);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeGlobalDeleteModal();
  });
</script>
