<div class="p-4 sm:p-6 lg:p-8 max-w-5xl mx-auto space-y-6">
  <!-- Header & Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-stone-200 pb-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-stone-400 font-medium">
        <a href="/admin/staff" class="hover:text-stone-700">Personal</a>
        <span>&bull;</span>
        <span>Lägg till Personal</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-extrabold text-stone-900 tracking-tight mt-1">Lägg till Personal</h2>
      <p class="text-xs text-stone-500 mt-0.5">Registrera en ny medarbetare, instruktör eller stallansvarig med systembehörighet.</p>
    </div>
    <div class="flex items-center gap-2 sm:gap-3 self-start sm:self-center">
      <a href="/admin/staff" class="px-4 py-2 border border-stone-300 hover:bg-stone-100 text-stone-700 text-xs font-semibold rounded-xl transition">
        Avbryt
      </a>
      <button type="submit" form="staffForm" class="px-5 py-2 bg-[#3d2314] hover:bg-[#2a170c] text-white text-xs font-semibold rounded-xl shadow-xs transition hover-lift">
        Spara personal
      </button>
    </div>
  </div>

  <% if (locals.error) { %>
    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-700 text-xs sm:text-sm rounded-xl flex items-center gap-3">
      <i class="fa-solid fa-triangle-exclamation text-rose-500 text-base"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <form id="staffForm" action="/admin/staff/create" method="POST" enctype="multipart/form-data" class="space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- Left Column (8 cols) -->
      <div class="lg:col-span-8 space-y-6">

        <!-- 1. Person- och inloggningsuppgifter -->
        <div class="bg-white rounded-2xl border border-stone-200 p-6 shadow-xs space-y-4">
          <h3 class="text-sm font-bold text-stone-900 border-b border-stone-100 pb-3 flex items-center gap-2">
            <i class="fa-regular fa-user text-stone-400"></i> Person- och inloggningsuppgifter
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Förnamn *</label>
              <input type="text" name="firstName" value="<%= formData?.firstName || '' %>" placeholder="t.ex. Maria" required
                class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#3d2314] focus:bg-white transition">
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Efternamn *</label>
              <input type="text" name="lastName" value="<%= formData?.lastName || '' %>" placeholder="t.ex. Berg" required
                class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#3d2314] focus:bg-white transition">
            </div>

            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Användarnamn *</label>
              <input type="text" name="username" value="<%= formData?.username || '' %>" placeholder="maria.b" required
                class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#3d2314] focus:bg-white transition">
              <p class="text-[10px] text-stone-400 mt-1">Används för inloggning i personal- eller adminvyn.</p>
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">E-postadress *</label>
              <input type="email" name="email" value="<%= formData?.email || '' %>" placeholder="maria@equira.se" required
                class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#3d2314] focus:bg-white transition">
            </div>

            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Telefonnummer</label>
              <input type="tel" name="phone" value="<%= formData?.phone || '' %>" placeholder="070-123 45 67"
                class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#3d2314] focus:bg-white transition">
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Lösenord</label>
              <input type="text" name="password" value="<%= formData?.password || '' %>" placeholder="Standard: staff123"
                class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#3d2314] focus:bg-white transition">
              <p class="text-[10px] text-stone-400 mt-1">Lämna tomt för standardlösenordet <code>staff123</code>.</p>
            </div>
          </div>
        </div>

        <!-- 2. Befattning & Specialistområden -->
        <div class="bg-white rounded-2xl border border-stone-200 p-6 shadow-xs space-y-4">
          <h3 class="text-sm font-bold text-stone-900 border-b border-stone-100 pb-3 flex items-center gap-2">
            <i class="fa-solid fa-id-badge text-stone-400"></i> Befattning & Kompetenser
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Titel / Befattning *</label>
              <select name="title" class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs sm:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-[#3d2314] focus:bg-white transition">
                <option value="Huvudinstruktör">Huvudinstruktör</option>
                <option value="Ridlärare / Instruktör" selected>Ridlärare / Instruktör</option>
                <option value="Stallansvarig">Stallansvarig</option>
                <option value="Stallpersonal">Stallpersonal</option>
                <option value="Hästskötare">Hästskötare</option>
                <option value="Unghästutbildare">Unghästutbildare</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Systembehörighet *</label>
              <select name="role" class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs sm:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-[#3d2314] focus:bg-white transition">
                <option value="STAFF" selected>Personal / Instruktör (Staff-vy & Schema)</option>
                <option value="ADMIN">Administratör (Full åtkomst till Adminpanelen)</option>
              </select>
            </div>

            <div class="md:col-span-2">
              <label class="block text-xs font-semibold text-stone-700 mb-1">Specialistområden & Kompetenser</label>
              <input type="text" name="specializations" value="<%= formData?.specializations || '' %>" placeholder="t.ex. Dressyr, Hoppning & Markarbete, Unghästar, Hovvård, Foderstater"
                class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#3d2314] focus:bg-white transition">
              <p class="text-[10px] text-stone-400 mt-1">Kommaseparerad lista över kompetenser och grenar som visas på personalkortet.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column (4 cols) -->
      <div class="lg:col-span-4 space-y-6">
        <!-- Profilbild (Multer Upload & Förhandsvisning) -->
        <div class="bg-white rounded-2xl border border-stone-200 p-6 shadow-xs space-y-4">
          <h3 class="text-sm font-bold text-stone-900 border-b border-stone-100 pb-3 flex items-center gap-2">
            <i class="fa-regular fa-image text-stone-400"></i> Profilbild
          </h3>

          <div class="flex flex-col items-center gap-4">
            <div class="relative group">
              <div class="w-28 h-28 rounded-full bg-[#1B3B2B] text-emerald-100 flex items-center justify-center font-bold text-2xl shadow-sm border-2 border-stone-200 overflow-hidden">
                <img id="avatarPreviewImg" 
                     src="<%= formData?.avatarUrl || '/images/default-staff.jpg' %>" 
                     alt="Förhandsvisning" 
                     class="w-full h-full object-cover <%= formData?.avatarUrl ? '' : 'opacity-80' %>">
              </div>
              <button type="button" 
                      onclick="document.getElementById('avatarFileInput').click()"
                      class="absolute inset-0 bg-black/40 rounded-full flex flex-col items-center justify-center text-white opacity-0 group-hover:opacity-100 transition duration-200 cursor-pointer">
                <i class="fa-solid fa-camera text-xl mb-1"></i>
                <span class="text-[10px] font-bold">Välj bild</span>
              </button>
            </div>

            <div class="w-full text-center space-y-3">
              <input type="file" 
                     id="avatarFileInput" 
                     name="avatar" 
                     accept="image/jpeg,image/png,image/webp,image/gif" 
                     class="hidden">

              <button type="button" 
                      onclick="document.getElementById('avatarFileInput').click()"
                      class="w-full py-2.5 px-4 bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs font-semibold rounded-xl border border-stone-200 flex items-center justify-center gap-2 transition hover-lift">
                <i class="fa-solid fa-arrow-up-from-bracket text-xs text-stone-500"></i>
                <span id="uploadButtonText">Ladda upp bildfil</span>
              </button>

              <div class="relative flex items-center justify-center my-2">
                <div class="border-t border-stone-200 w-full"></div>
                <span class="bg-white px-2 text-[10px] text-stone-400 uppercase font-semibold">eller URL</span>
              </div>

              <div>
                <input type="text" 
                       id="avatarUrlInput"
                       name="avatarUrl" 
                       value="<%= formData?.avatarUrl || '' %>" 
                       placeholder="/images/default-staff.jpg"
                       class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-[#3d2314] focus:bg-white">
                <p class="text-[10px] text-stone-400 mt-1">Stöd för JPG, PNG, WebP och GIF (max 5 MB).</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Systemintegration Info Card -->
        <div class="bg-stone-50 rounded-2xl border border-stone-200 p-5 space-y-3">
          <div class="flex items-center gap-2 text-stone-800 font-bold text-xs">
            <i class="fa-solid fa-circle-info text-emerald-700"></i>
            <span>Hur personal integreras i Equira</span>
          </div>
          <ul class="text-[11px] text-stone-600 space-y-2 leading-relaxed">
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check text-emerald-600 mt-0.5 text-[10px]"></i>
              <span><strong>Instruktör:</strong> Kan schemaläggas och väljas som ansvarig instruktör vid skapande av lektioner.</span>
            </li>
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check text-emerald-600 mt-0.5 text-[10px]"></i>
              <span><strong>Stalluppgifter:</strong> Kan tilldelas dagliga mocknings-, fodrings- och visitationsuppgifter.</span>
            </li>
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check text-emerald-600 mt-0.5 text-[10px]"></i>
              <span><strong>Snabb-inloggning:</strong> Kan logga in i personalportalen via användarnamn eller personalsnabbval.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </form>
</div>

<!-- Avatar Live Preview Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fileInput = document.getElementById('avatarFileInput');
    const previewImg = document.getElementById('avatarPreviewImg');
    const buttonText = document.getElementById('uploadButtonText');
    const urlInput = document.getElementById('avatarUrlInput');

    if (fileInput && previewImg) {
      fileInput.addEventListener('change', (e) => {
        const file = e.target.files && e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (event) => {
            previewImg.src = event.target.result;
            previewImg.classList.remove('opacity-80');
          };
          reader.readAsDataURL(file);

          if (buttonText) {
            buttonText.textContent = file.name.length > 20 ? file.name.slice(0, 18) + '...' : file.name;
          }
        }
      });
    }

    if (urlInput && previewImg) {
      urlInput.addEventListener('input', (e) => {
        const url = e.target.value.trim();
        if (url && (!fileInput || !fileInput.files.length)) {
          previewImg.src = url;
          previewImg.classList.remove('opacity-80');
        }
      });
    }
  });
</script>
