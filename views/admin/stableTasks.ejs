<div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto space-y-6 sm:space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <div class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Drift & Skötsel</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight mt-1">Stalluppgifter & Skötsel</h2>
      <p class="text-xs sm:text-sm text-stone-500 mt-1">Daglig tillsyn, utfodring och rutiner för anläggningens stallar och hagar.</p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin/tasks/create" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#3d2314] hover:bg-[#2c190e] text-white px-5 py-2.5 rounded-xl font-medium text-sm shadow-sm transition hover-lift">
        <i class="fa-solid fa-plus text-xs"></i>
        <span>Ny stalluppgift</span>
      </a>
    </div>
  </div>

  <% if (locals.success) { %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm rounded-xl flex items-center gap-2.5 shadow-sm">
      <i class="fa-solid fa-circle-check text-emerald-600 text-base"></i>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (locals.error) { %>
    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-sm rounded-xl flex items-center gap-2.5 shadow-sm">
      <i class="fa-solid fa-triangle-exclamation text-rose-600 text-base"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Aktuella Uppgifter Section (Matching PDF 3 page 12) -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-base sm:text-lg font-bold text-stone-900">
        Aktuella Uppgifter <span class="text-xs font-semibold text-stone-500 bg-stone-100 px-2 py-0.5 rounded-full ml-1"><%= data.currentCount %> kvar</span>
      </h3>
      <span class="text-xs text-stone-400 font-medium">Sorterat efter tid</span>
    </div>

    <div class="space-y-3">
      <% data.currentTasks.forEach(task => { %>
        <div class="bg-white rounded-2xl border <%= task.priority === 'Akut' ? 'border-rose-300' : (task.priority === 'Viktig' ? 'border-amber-300' : 'border-stone-200') %> p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover-lift">
          <div class="space-y-2 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs <%= task.priorityClass %>">
                <% if (task.priority === 'Akut') { %><i class="fa-solid fa-triangle-exclamation mr-1"></i><% } %>
                <%= task.priority.toUpperCase() %>
              </span>
              <h4 class="text-base font-bold text-stone-900"><%= task.title %></h4>
              <span class="text-xs text-stone-400">&bull; <%= task.location %></span>
            </div>

            <% if (task.instructions) { %>
              <p class="text-xs text-stone-600 pl-1"><%= task.instructions %></p>
            <% } %>

            <div class="flex flex-wrap items-center gap-3 pt-1 text-xs">
              <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-full bg-stone-200 text-stone-700 flex items-center justify-center font-bold text-[10px]">
                  <%= task.assignedStaffName.charAt(0) %>
                </div>
                <span class="text-stone-700 font-medium"><%= task.assignedStaffName %></span>
              </div>
              <span class="text-stone-400">&bull;</span>
              <span class="text-stone-500">Tid: <strong><%= task.time %></strong></span>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 self-start sm:self-center w-full sm:w-auto justify-end pt-2 sm:pt-0 border-t sm:border-t-0 border-stone-100">
            <a href="/admin/tasks/<%= task.id %>/edit" class="inline-flex items-center gap-1.5 px-3 py-2 bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-semibold rounded-xl transition" title="Redigera stalluppgift">
              <i class="fa-solid fa-pen-to-square text-[11px]"></i>
              <span>Redigera</span>
            </a>
            <form action="/admin/tasks/<%= task.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Är du säker på att du vill ta bort stalluppgiften &quot;<%= task.title %>&quot;?');">
              <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-semibold rounded-xl transition" title="Ta bort stalluppgift">
                <i class="fa-regular fa-trash-can text-[11px]"></i>
                <span>Ta bort</span>
              </button>
            </form>
            <form action="/staff/tasks/<%= task.id %>/complete" method="POST" class="inline">
              <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl transition shadow-sm flex items-center gap-1.5">
                <i class="fa-regular fa-circle-check"></i>
                <span>Kvittera</span>
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <!-- Klara Uppgifter Section (Matching PDF 3 page 12) -->
  <div class="space-y-4 pt-4 border-t border-stone-200">
    <div class="flex items-center justify-between">
      <h3 class="text-base sm:text-lg font-bold text-stone-900">
        Klara Uppgifter <span class="text-xs font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-full ml-1"><%= data.completedCount %> slutförda idag</span>
      </h3>
      <span class="text-xs text-stone-400 font-medium"><i class="fa-solid fa-clock-rotate-left mr-1"></i> Logg</span>
    </div>

    <div class="space-y-2">
      <% data.completedTasks.forEach(task => { %>
        <div class="bg-white/80 rounded-2xl border border-stone-200 p-3.5 sm:p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs hover:bg-stone-50 transition">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-sm font-bold shrink-0">
              <i class="fa-solid fa-check"></i>
            </div>
            <div>
              <h4 class="font-bold text-stone-800 text-sm"><%= task.title %></h4>
              <p class="text-stone-400 text-[11px]">
                <%= task.location %> &bull; Signerad av <%= task.completedByName || task.assignedStaffName %>
              </p>
            </div>
          </div>
          <div class="flex items-center gap-2 self-end sm:self-center">
            <span class="text-emerald-700 font-semibold px-2.5 py-1 bg-emerald-50 rounded-lg">Kvitterad</span>
            <a href="/admin/tasks/<%= task.id %>/edit" class="p-2 text-stone-400 hover:text-stone-700 hover:bg-stone-200/60 rounded-lg transition" title="Redigera">
              <i class="fa-solid fa-pen-to-square text-xs"></i>
            </a>
            <form action="/admin/tasks/<%= task.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Är du säker på att du vill ta bort stalluppgiften &quot;<%= task.title %>&quot;?');">
              <button type="submit" class="p-2 text-rose-400 hover:text-rose-700 hover:bg-rose-100/60 rounded-lg transition" title="Ta bort">
                <i class="fa-regular fa-trash-can text-xs"></i>
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</div>
