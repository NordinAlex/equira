<div class="p-4 sm:p-6 lg:p-8 max-w-6xl mx-auto space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-stone-200 pb-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-stone-400 font-medium">
        <a href="/admin/lessons" class="hover:text-stone-700">Lektioner</a>
        <span>&bull;</span>
        <span>Redigera lektion</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-extrabold text-stone-900 tracking-tight mt-1">Redigera lektion: <%= lesson.title %></h2>
      <p class="text-xs text-stone-500 mt-0.5">Uppdatera ridpass, instruktör, arena, tid och deltagarkapacitet.</p>
    </div>
    <div class="flex items-center gap-2 sm:gap-3 self-start sm:self-center">
      <a href="/admin/lessons" class="px-4 py-2 border border-stone-300 hover:bg-stone-100 text-stone-700 text-xs font-semibold rounded-xl transition">
        Avbryt
      </a>
      <a href="/admin/assign/<%= lesson.id %>" class="px-4 py-2 bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs font-semibold rounded-xl transition flex items-center gap-1.5">
        <i class="fa-solid fa-horseshoe text-stone-500"></i>
        <span>Tilldela hästar</span>
      </a>
      <button type="submit" form="lessonEditForm" class="px-5 py-2 bg-equira-cognac-800 hover:bg-[#2a170c] text-white text-xs font-semibold rounded-xl shadow-sm transition flex items-center gap-1.5">
        <i class="fa-solid fa-floppy-disk text-xs"></i>
        <span>Spara ändringar</span>
      </button>
    </div>
  </div>

  <% if (error) { %>
    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl flex items-center gap-2">
      <i class="fa-solid fa-triangle-exclamation text-rose-500"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <form id="lessonEditForm" action="/admin/lessons/<%= lesson.id %>/edit" method="POST">
    <input type="hidden" name="hasStudentSelection" value="1">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- Left Column: Lesson Details (8 cols) -->
      <div class="lg:col-span-8 space-y-6">

        <!-- 1. Grundläggande information -->
        <div class="bg-white rounded-2xl border border-stone-200 p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-stone-100 pb-3">
            <h3 class="text-sm font-bold text-stone-900 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center text-xs font-black">1</span>
              Grundläggande information
            </h3>
            <span class="text-[10px] uppercase font-bold text-stone-400 tracking-wider">ALLMÄNT</span>
          </div>

          <div>
            <label class="block text-xs font-semibold text-stone-700 mb-1">Lektionens namn / Rubrik *</label>
            <input type="text" id="lessonTitleInput" name="title" value="<%= lesson.title || '' %>" required
              class="w-full px-3.5 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-sm font-medium text-stone-900 focus:outline-none focus:ring-2 focus:ring-equira-cognac-700 focus:bg-white">
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Lektionstyp *</label>
              <select id="lessonTypeSelect" name="lessonType" class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm">
                <% ['Hoppning', 'Dressyr', 'Allround', 'Markarbete', 'Teori', 'Uteritt'].forEach(type => { %>
                  <option value="<%= type %>" <%= lesson.lessonType === type ? 'selected' : '' %>><%= type %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Svårighetsgrad / Ridnivå</label>
              <select id="lessonLevelSelect" name="level" class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm">
                <% ['Nybörjare', 'Nivå 1', 'Nivå 2', 'Nivå 3 - Medel', 'Nivå 4 - Avancerad', 'Alla nivåer'].forEach(lvl => { %>
                  <option value="<%= lvl %>" <%= lesson.level === lvl ? 'selected' : '' %>><%= lvl %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Status</label>
              <select name="status" class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm font-medium">
                <% ['Schemalagd', 'Pågår', 'Genomförd', 'Inställd'].forEach(st => { %>
                  <option value="<%= st %>" <%= lesson.status === st ? 'selected' : '' %>><%= st %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-stone-700 mb-1">Målgrupp</label>
            <input type="text" name="targetGroup" value="<%= lesson.targetGroup || '' %>" placeholder="t.ex. Ungdom & Junior (10-18 år) eller Vuxengrupp" class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm">
          </div>
        </div>

        <!-- 2. Tid, Arena & Resursplanering -->
        <div class="bg-white rounded-2xl border border-stone-200 p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-stone-100 pb-3">
            <h3 class="text-sm font-bold text-stone-900 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center text-xs font-black">2</span>
              Tid, Arena & Resursplanering
            </h3>
            <span class="text-[10px] uppercase font-bold text-stone-400 tracking-wider">RESURSER</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Datum *</label>
              <input type="date" id="lessonDateInput" name="date" value="<%= lesson.date || '' %>" required
                class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm">
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Starttid *</label>
              <input type="time" id="lessonStartTimeInput" name="startTime" value="<%= lesson.startTime || '17:30' %>" required
                class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm">
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Sluttid *</label>
              <input type="time" id="lessonEndTimeInput" name="endTime" value="<%= lesson.endTime || '18:30' %>" required
                class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Ridlärare / Instruktör</label>
              <select name="instructorId" class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm">
                <option value="">Ingen vald</option>
                <% instructors.forEach(inst => { %>
                  <option value="<%= inst.id %>" <%= lesson.instructorId === inst.id ? 'selected' : '' %>>
                    <%= inst.fullName %> (<%= inst.staffProfile ? inst.staffProfile.title : 'Instruktör' %>)
                  </option>
                <% }); %>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Arena / Ridbana</label>
              <select id="lessonArenaSelect" name="arenaId" class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm">
                <option value="">Ingen vald</option>
                <% arenas.forEach(arena => { %>
                  <option value="<%= arena.id %>" 
                          <%= lesson.arenaId === arena.id ? 'selected' : '' %> 
                          data-image="<%= arena.imageUrl || (arena.isIndoor ? '/images/arena-preview.jpg' : '/images/arena-outdoor.jpg') %>"
                          data-surface="<%= arena.surfaceType || 'Fibersand' %>"
                          data-name="<%= arena.name %>" 
                          data-dimensions="<%= arena.dimensions || '20×60m' %>">
                    <%= arena.name %> (<%= arena.dimensions || '20×60m' %>, <%= arena.surfaceType || 'Fibersand' %>)
                  </option>
                <% }); %>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-stone-700 mb-1">Stallpersonalens instruktioner</label>
            <textarea name="staffInstructions" rows="2" placeholder="Bygg 4 enkelhinder och en kombination på medellinjen. Framskrittning påbörjas kl 17:20."
              class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-equira-cognac-700"><%= lesson.staffInstructions || '' %></textarea>
          </div>
        </div>

        <!-- 3. Kapacitet, Grupp & Elever -->
        <div class="bg-white rounded-2xl border border-stone-200 p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-stone-100 pb-3">
            <h3 class="text-sm font-bold text-stone-900 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center text-xs font-black">3</span>
              Kapacitet & Elevbokningar
            </h3>
            <span class="text-[10px] uppercase font-bold text-stone-400 tracking-wider">DELTAGARE</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Max antal deltagare</label>
              <input type="number" id="lessonMaxInput" name="maxParticipants" value="<%= lesson.maxParticipants || 8 %>" min="1" max="16" class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm">
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Min antal deltagare</label>
              <input type="number" name="minParticipants" value="<%= lesson.minParticipants || 4 %>" min="1" max="10" class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm">
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-semibold text-stone-700">Inbokade elever (<span id="selectedCountText"><%= bookedStudentIds.length %></span> st)</label>
              <span class="text-[10px] text-stone-400">Kryssa i de elever som ska ingå i lektionen</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 max-h-48 overflow-y-auto p-3 bg-stone-50 rounded-xl border border-stone-200">
              <% students.forEach(s => { %>
                <% 
                  const mStatus = s.membershipStatus || (s.studentProfile && s.studentProfile.membershipStatus) || 'Aktiv';
                  if (mStatus === 'Kö') return;
                  const isTrial = mStatus !== 'Aktiv';
                  const isChecked = bookedStudentIds.includes(s.id); 
                %>
                <label class="flex items-center justify-between gap-2 text-xs text-stone-700 p-1.5 hover:bg-white rounded-lg cursor-pointer transition border border-transparent hover:border-stone-200">
                  <div class="flex items-center gap-2 min-w-0">
                    <input type="checkbox" name="studentIds" value="<%= s.id %>" <%= isChecked ? 'checked' : '' %> class="student-checkbox rounded text-equira-cognac-700 focus:ring-equira-cognac-700 shrink-0">
                    <span class="truncate"><%= s.fullName %></span>
                  </div>
                  <% if (isTrial) { %>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-200 shrink-0" title="Medlemskapsstatus: <%= mStatus %>">Pröv</span>
                  <% } %>
                </label>
              <% }); %>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-stone-700 mb-1">Krav på hästmaterial & bana</label>
            <input type="text" name="equipmentRequirements" value="<%= lesson.equipmentRequirements || '' %>" placeholder="Kräver C- eller D-ponny, Hinderpark framplockad, Säkerhetsväst obligatorisk"
              class="w-full px-3.5 py-2 bg-stone-50 border border-stone-200 rounded-xl text-sm">
          </div>
        </div>

      </div>

      <!-- Right Column: Live Preview & Danger Zone (4 cols) -->
      <div class="lg:col-span-4 space-y-6">

        <!-- Live Preview Card -->
        <div class="bg-white rounded-2xl border border-stone-200 p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-stone-100">
            <span class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Förhandsgranskning</span>
            <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-bold">AKTIV</span>
          </div>

          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <span id="previewTag" class="px-2 py-0.5 rounded bg-amber-100 text-amber-900 font-bold text-xs"><%= lesson.lessonType %> • <%= lesson.level %></span>
              <span id="previewCapacity" class="text-xs text-stone-500"><i class="fa-solid fa-users mr-1"></i> Max <%= lesson.maxParticipants %> elever</span>
            </div>

            <h4 id="previewTitle" class="text-lg font-bold text-stone-900 leading-tight"><%= lesson.title %></h4>
            <p id="previewArena" class="text-xs text-stone-500"><i class="fa-solid fa-location-dot mr-1"></i> <%= lesson.arena ? lesson.arena.name : 'Ridhus' %></p>

            <div class="p-3 bg-stone-50 rounded-xl border border-stone-100 flex items-center justify-between text-xs">
              <span class="text-stone-600 font-medium">Tid:</span>
              <span id="previewTime" class="font-bold text-stone-900"><%= lesson.startTime %> - <%= lesson.endTime %></span>
            </div>

            <div class="p-3 bg-stone-50 rounded-xl border border-stone-100 flex items-center justify-between text-xs">
              <span class="text-stone-600 font-medium">Inbokade:</span>
              <span id="previewBooked" class="font-bold text-stone-900"><%= bookedStudentIds.length %> deltagare</span>
            </div>

            <div class="rounded-xl overflow-hidden h-32 relative shadow-inner bg-stone-100 group">
              <img id="previewLessonImage" 
                   src="<%= (lesson.arena && lesson.arena.imageUrl) || (lesson.arena && lesson.arena.isIndoor ? '/images/arena-preview.jpg' : '/images/arena-outdoor.jpg') %>" 
                   alt="Förhandsgranskning av Ridbana" 
                   class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                   onerror="this.onerror=null; this.src='/images/arena-preview.jpg';">
              <div id="previewSurfaceBadge" class="absolute bottom-2 left-2 bg-black/60 backdrop-blur-md px-2.5 py-1 rounded-lg text-white text-[10px] font-medium flex items-center gap-1.5 shadow-sm">
                <i class="fa-solid fa-layer-group text-[9px] text-amber-300"></i>
                <span id="previewSurfaceText">Underlag: <%= (lesson.arena && lesson.arena.surfaceType) || 'Fibersand' %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Hästtilldelning Quick Card -->
        <div class="bg-[#fcfaf7] rounded-2xl border border-[#ebdccb] p-5 shadow-xs space-y-3">
          <div class="flex items-center gap-2 text-stone-900 font-bold text-sm">
            <i class="fa-solid fa-horseshoe text-equira-cognac-700"></i>
            <span>Hästtilldelning</span>
          </div>
          <p class="text-xs text-stone-600">
            Klicka nedan för att gå direkt till tilldelningsvyn för att fördela hästar till eleverna.
          </p>
          <a href="/admin/assign/<%= lesson.id %>" class="w-full py-2 px-4 bg-equira-cognac-700 hover:bg-[#381e1e] text-white text-xs font-semibold rounded-xl transition flex items-center justify-center gap-1.5 shadow-xs">
            <span>Öppna tilldelning</span>
            <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
        </div>

        <!-- Farlig zon / Ta bort lektion -->
        <div class="bg-white rounded-2xl border border-rose-200 p-6 shadow-sm space-y-3">
          <h3 class="text-sm font-bold text-rose-800 flex items-center gap-2">
            <i class="fa-solid fa-triangle-exclamation text-rose-500"></i> Farlig zon
          </h3>
          <p class="text-xs text-stone-500">
            Om lektionen tas bort raderas passet och alla tillhörande bokningar permanent.
          </p>
          <button type="button" 
            data-delete-action="/admin/lessons/<%= lesson.id %>/delete"
            data-delete-title="Ta bort lektion?"
            data-delete-item="<%= lesson.title %>"
            data-delete-prefix="Är du säker på att du vill ta bort lektionspasset"
            data-delete-warning="Alla kopplade elev- och hästbokningar raderas permanent."
            data-delete-submit="Ja, ta bort lektion"
            class="w-full py-2.5 px-4 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-semibold text-xs rounded-xl transition flex items-center justify-center gap-2 cursor-pointer">
            <i class="fa-regular fa-trash-can"></i>
            <span>Ta bort denna lektion</span>
          </button>
        </div>

      </div>

    </div>
  </form>

<!-- Live Preview Script -->
<script>

  document.addEventListener('DOMContentLoaded', () => {
    const titleInput = document.getElementById('lessonTitleInput');
    const typeSelect = document.getElementById('lessonTypeSelect');
    const levelSelect = document.getElementById('lessonLevelSelect');
    const arenaSelect = document.getElementById('lessonArenaSelect');
    const startInput = document.getElementById('lessonStartTimeInput');
    const endInput = document.getElementById('lessonEndTimeInput');
    const maxInput = document.getElementById('lessonMaxInput');
    const checkboxes = document.querySelectorAll('.student-checkbox');

    const previewTitle = document.getElementById('previewTitle');
    const previewTag = document.getElementById('previewTag');
    const previewArena = document.getElementById('previewArena');
    const previewTime = document.getElementById('previewTime');
    const previewCapacity = document.getElementById('previewCapacity');
    const previewBooked = document.getElementById('previewBooked');
    const countText = document.getElementById('selectedCountText');

    function updatePreview() {
      if (titleInput && previewTitle) {
        previewTitle.textContent = titleInput.value.trim() || 'Lektionsrubrik';
      }
      if (typeSelect && levelSelect && previewTag) {
        previewTag.textContent = `${typeSelect.value} • ${levelSelect.value}`;
      }
      if (arenaSelect && previewArena) {
        const opt = arenaSelect.options[arenaSelect.selectedIndex];
        const name = opt ? (opt.getAttribute('data-name') || opt.text) : 'Ridhus';
        const img = opt ? opt.getAttribute('data-image') : null;
        const surf = opt ? opt.getAttribute('data-surface') : null;

        previewArena.innerHTML = `<i class="fa-solid fa-location-dot mr-1"></i> ${name}`;
        if (img) {
          const previewImg = document.getElementById('previewLessonImage');
          if (previewImg) previewImg.src = img;
        }
        if (surf) {
          const surfEl = document.getElementById('previewSurfaceText');
          if (surfEl) surfEl.textContent = `Underlag: ${surf}`;
        }
      }
      if (startInput && endInput && previewTime) {
        previewTime.textContent = `${startInput.value || '17:30'} - ${endInput.value || '18:30'}`;
      }
      if (maxInput && previewCapacity) {
        previewCapacity.innerHTML = `<i class="fa-solid fa-users mr-1"></i> Max ${maxInput.value || 8} elever`;
      }
      if (checkboxes && previewBooked && countText) {
        const checkedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
        previewBooked.textContent = `${checkedCount} deltagare`;
        countText.textContent = checkedCount;
      }
    }

    [titleInput, typeSelect, levelSelect, arenaSelect, startInput, endInput, maxInput].forEach(el => {
      if (el) {
        el.addEventListener('input', updatePreview);
        el.addEventListener('change', updatePreview);
      }
    });

    checkboxes.forEach(cb => {
      cb.addEventListener('change', updatePreview);
    });
  });
</script>
