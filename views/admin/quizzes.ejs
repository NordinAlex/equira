<div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto space-y-6 sm:space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <div class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Teori & Utbildning</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight mt-1">Quiz & Kunskapsprov</h2>
      <p class="text-xs sm:text-sm text-stone-500 mt-1 max-w-2xl">
        Skapa, schemalägg och följ upp teoriprov och kunskapsquiz för ridskolans elever, grupper och ryttarmärken.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin/quizzes/create" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#3d2314] hover:bg-[#2c190e] text-white px-5 py-2.5 rounded-xl font-medium text-sm shadow-sm transition hover-lift">
        <i class="fa-solid fa-plus text-xs"></i>
        <span>Skapa nytt quiz</span>
      </a>
    </div>
  </div>

  <!-- Quiz Cards List -->
  <div class="space-y-4">
    <% if (!quizzes || quizzes.length === 0) { %>
      <div class="bg-white rounded-2xl border border-stone-200 p-12 text-center space-y-4 shadow-sm">
        <div class="w-16 h-16 rounded-full bg-amber-50 text-amber-700 flex items-center justify-center mx-auto text-2xl">
          <i class="fa-solid fa-circle-question"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-stone-800">Inga kunskapsquiz skapade ännu</h3>
          <p class="text-xs text-stone-500 max-w-md mx-auto mt-1">
            Skapa ert första teoriprov med flervalsfrågor och pedagogiska förklaringar kopplade till Svenska Ridsportförbundets ryttarmärken.
          </p>
        </div>
        <a href="/admin/quizzes/create" class="inline-flex items-center gap-2 bg-[#3d2314] hover:bg-[#2c190e] text-white px-5 py-2.5 rounded-xl text-xs font-semibold shadow-sm transition">
          <i class="fa-solid fa-plus text-xs"></i>
          <span>Skapa det första quizet</span>
        </a>
      </div>
    <% } else { %>
      <% quizzes.forEach(quiz => { %>
        <div class="bg-white rounded-2xl border border-stone-200 p-5 sm:p-6 shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-4 sm:gap-6 hover-lift transition">
          <div class="space-y-2 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold <%= quiz.badgeClass %>">
                <%= quiz.category %>
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-stone-600">
                <%= quiz.difficulty %>
              </span>
              <% if (quiz.isPublished) { %>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Publicerad
                </span>
              <% } %>
            </div>

            <h3 class="text-base sm:text-lg font-bold text-stone-900 tracking-tight"><%= quiz.title %></h3>
            <p class="text-xs text-stone-500 max-w-2xl"><%= quiz.description %></p>

            <div class="flex flex-wrap items-center gap-4 text-xs text-stone-400 pt-1">
              <span><i class="fa-regular fa-file-lines mr-1"></i> <strong><%= quiz.questionCount %></strong> frågor</span>
              <span><i class="fa-regular fa-clock mr-1"></i> <%= quiz.timeLimitMinutes %> min tidsgräns</span>
              <span><i class="fa-solid fa-percent mr-1"></i> <%= quiz.passPercentage %>% godkäntgräns</span>
              <% if (quiz.equestrianBadge) { %>
                <span class="text-amber-800 font-semibold bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200/60">
                  <i class="fa-solid fa-medal mr-1"></i> <%= quiz.equestrianBadge %>
                </span>
              <% } %>
            </div>
          </div>

          <div class="flex flex-row lg:flex-col items-center lg:items-end justify-between lg:justify-center gap-3 lg:min-w-[220px] border-t lg:border-t-0 lg:border-l border-stone-100 pt-3 lg:pt-0 lg:pl-6 w-full lg:w-auto">
            <div class="text-left lg:text-right">
              <span class="text-[10px] uppercase font-bold text-stone-400">Elevgenomströmning</span>
              <div class="text-xs sm:text-sm font-bold text-stone-900 mt-0.5">
                <%= quiz.completedCount %> elever &bull; <strong class="text-emerald-700"><%= quiz.averageScore %>% snitt</strong>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 shrink-0">
              <a href="/student/quiz/start/<%= quiz.id %>" title="Provkör quizet som elev" class="px-3 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs font-semibold rounded-xl transition shadow-2xs flex items-center gap-1.5">
                <i class="fa-solid fa-play text-[10px] text-stone-600"></i>
                <span>Testa</span>
              </a>

              <a href="/admin/quizzes/<%= quiz.id %>/edit" title="Redigera quiz och frågor" class="px-3 py-1.5 bg-[#3d2314] hover:bg-[#2a170c] text-white text-xs font-semibold rounded-xl transition shadow-2xs flex items-center gap-1.5">
                <i class="fa-solid fa-pen-to-square text-[10px]"></i>
                <span>Redigera</span>
              </a>

              <button type="button" 
                data-delete-action="/admin/quizzes/<%= quiz.id %>/delete"
                data-delete-title="Ta bort quiz?"
                data-delete-item="<%= quiz.title %>"
                data-delete-prefix="Är du säker på att du vill ta bort quizet"
                data-delete-warning="Alla frågor och registrerade provresultat i detta quiz raderas permanent."
                data-delete-submit="Ja, ta bort quiz"
                title="Ta bort detta quiz" 
                class="px-2.5 py-1.5 text-stone-400 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition text-xs border border-transparent hover:border-rose-200 cursor-pointer">
                <i class="fa-regular fa-trash-can"></i>
              </button>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>
