  </div>
</div>

<script>
  function calcBreakMetrics(startTime, endTime) {
    if (!startTime || !endTime) return { elapsedHours: 9, breakMinutes: 60, breakStr: '01:00', breakLabel: '1 rast', workHours: 8.0 };
    const [sh, sm] = startTime.split(':').map(Number);
    let [eh, em] = endTime.split(':').map(Number);
    let startMin = (sh || 0) * 60 + (sm || 0);
    let endMin = (eh || 0) * 60 + (em || 0);
    if (endMin < startMin) endMin += 24 * 60;
    const elapsedMinutes = endMin - startMin;
    const elapsedHours = Math.round((elapsedMinutes / 60) * 10) / 10;

    let breakMinutes = 60;
    let breakStr = '01:00';
    let breakLabel = '1 rast';

    if (elapsedMinutes < 300) {
      breakMinutes = 0;
      breakStr = '00:00';
      breakLabel = 'Ingen rast';
    } else if (elapsedMinutes < 450) {
      breakMinutes = 30;
      breakStr = '00:30';
      breakLabel = '1 rast';
    } else if (elapsedMinutes < 630) {
      breakMinutes = 60;
      breakStr = '01:00';
      breakLabel = '1 rast';
    } else {
      breakMinutes = 90;
      breakStr = '01:30';
      breakLabel = '2 raster';
    }

    const workHours = Math.round(((elapsedMinutes - breakMinutes) / 60) * 10) / 10;
    return { elapsedMinutes, elapsedHours, breakMinutes, breakStr, breakLabel, workHours };
  }

  function updateCreateShiftCalc() {
    const s = document.getElementById('createStartTime').value;
    const e = document.getElementById('createEndTime').value;
    const res = calcBreakMetrics(s, e);
    document.getElementById('createHours').value = res.workHours;
    document.getElementById('createBreakHint').innerHTML = `Beräknad rast från pass: <strong>${res.breakLabel} (${res.breakStr})</strong>`;
    document.getElementById('createElapsedHint').textContent = `Passlängd: ${res.elapsedHours} tim`;
  }

  function updateEditShiftCalc() {
    const s = document.getElementById('editStartTime').value;
    const e = document.getElementById('editEndTime').value;
    const res = calcBreakMetrics(s, e);
    document.getElementById('editHours').value = res.workHours;
    document.getElementById('editBreakHint').innerHTML = `Beräknad rast från pass: <strong>${res.breakLabel} (${res.breakStr})</strong>`;
    document.getElementById('editElapsedHint').textContent = `Passlängd: ${res.elapsedHours} tim`;
  }

  function openCreateShiftModal() {
    document.getElementById('createShiftModal').classList.remove('hidden');
    updateCreateShiftCalc();
  }

  function openCreateShiftModalWithParams(userId, dateStr) {
    if (userId) document.getElementById('createShiftUserId').value = userId;
    if (dateStr) document.getElementById('createShiftDate').value = dateStr;
    document.getElementById('createShiftModal').classList.remove('hidden');
    updateCreateShiftCalc();
  }

  function closeCreateShiftModal() {
    document.getElementById('createShiftModal').classList.add('hidden');
  }

  function openQuickWeekModal() {
    document.getElementById('quickWeekModal').classList.remove('hidden');
  }

  function openQuickWeekModalWithDate(dateStr) {
    if (dateStr) document.getElementById('quickWeekMondayDate').value = dateStr;
    document.getElementById('quickWeekModal').classList.remove('hidden');
  }

  function closeQuickWeekModal() {
    document.getElementById('quickWeekModal').classList.add('hidden');
  }

  let currentEditingShift = null;

  function openEditShiftModal(shiftOrId, startTime, endTime, hours, shiftName, location, note, status) {
    let data = {};
    if (typeof shiftOrId === 'object' && shiftOrId !== null) {
      data = shiftOrId;
    } else {
      data = {
        id: shiftOrId,
        startTime,
        endTime,
        hours,
        shiftName,
        location,
        note,
        adminNote: '',
        status,
        originalPlannedStartTime: startTime,
        originalPlannedEndTime: endTime,
        checkInTimeStr: '–',
        checkOutTimeStr: '–',
        isAdjusted: false
      };
    }
    currentEditingShift = data;

    document.getElementById('editShiftForm').action = `/admin/staff-schedule/edit/${data.id}`;
    document.getElementById('editStartTime').value = data.startTime || '12:00';
    document.getElementById('editEndTime').value = data.endTime || '21:00';
    document.getElementById('editHours').value = data.hours || 8.0;
    document.getElementById('editShiftName').value = data.shiftName || 'Stallpersonal (6851)';
    document.getElementById('editLocation').value = data.location || 'Huvudstallet';
    document.getElementById('editNote').value = data.note || '';
    document.getElementById('editAdminNote').value = data.adminNote || '';
    document.getElementById('editStatus').value = data.status || 'BOKAD';

    // Stamping & audit display
    const checkIn = data.checkInTimeStr && data.checkInTimeStr !== '–' ? data.checkInTimeStr : 'Ej stämplat';
    const checkOut = data.checkOutTimeStr && data.checkOutTimeStr !== '–' ? data.checkOutTimeStr : (data.isClockedIn ? 'Instämplad (pågår)' : 'Ej stämplat');
    document.getElementById('editModalCheckInTime').textContent = checkIn;
    document.getElementById('editModalCheckOutTime').textContent = checkOut;

    const origStart = data.originalPlannedStartTime || data.startTime || '12:00';
    const origEnd = data.originalPlannedEndTime || data.endTime || '21:00';
    document.getElementById('editModalOrigPlanned').textContent = `${origStart} – ${origEnd}`;

    // Enable/disable quick punch button
    const hasPunchTimes = (data.checkInTimeStr && data.checkInTimeStr !== '–') || (data.checkOutTimeStr && data.checkOutTimeStr !== '–');
    const btnPunch = document.getElementById('btnApplyStaffPunch');
    if (btnPunch) btnPunch.style.display = hasPunchTimes ? 'inline-flex' : 'none';

    // Status badge & audit note
    const badge = document.getElementById('editShiftAuditBadge');
    const adjInfo = document.getElementById('editModalAdjustedInfo');
    const adjText = document.getElementById('editModalAdjustedText');

    if (data.isAdjusted) {
      badge.className = 'text-[10px] px-2 py-0.5 rounded-full font-semibold border bg-amber-100 text-amber-900 border-amber-300';
      badge.innerHTML = '<i class="fa-solid fa-pen-nib mr-1"></i>Justerad';
      adjInfo.classList.remove('hidden');
      adjText.innerHTML = `Detta pass justerades av <strong>${data.adjustedBy || 'Administratör'}</strong>${data.adjustedAtStr ? ' kl ' + data.adjustedAtStr : ''}. Personalens originaltider bevaras orörda som underlag.`;
    } else if (data.isClockedIn) {
      badge.className = 'text-[10px] px-2 py-0.5 rounded-full font-semibold border bg-emerald-100 text-emerald-800 border-emerald-300';
      badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse inline-block mr-1"></span>Instämplad nu';
      adjInfo.classList.add('hidden');
    } else if (data.checkInTimeStr && data.checkInTimeStr !== '–') {
      badge.className = 'text-[10px] px-2 py-0.5 rounded-full font-semibold border bg-sky-100 text-sky-800 border-sky-300';
      badge.innerHTML = '<i class="fa-solid fa-fingerprint mr-1"></i>Stämplat pass';
      adjInfo.classList.add('hidden');
    } else {
      badge.className = 'text-[10px] px-2 py-0.5 rounded-full font-semibold border bg-stone-100 text-stone-700 border-stone-200';
      badge.innerHTML = 'Planerat pass';
      adjInfo.classList.add('hidden');
    }

    updateEditShiftCalc();
    document.getElementById('editShiftModal').classList.remove('hidden');
  }

  function applyStaffPunchTimes() {
    if (!currentEditingShift) return;
    if (currentEditingShift.checkInTimeStr && currentEditingShift.checkInTimeStr !== '–') {
      document.getElementById('editStartTime').value = currentEditingShift.checkInTimeStr;
    }
    if (currentEditingShift.checkOutTimeStr && currentEditingShift.checkOutTimeStr !== '–') {
      document.getElementById('editEndTime').value = currentEditingShift.checkOutTimeStr;
    }
    updateEditShiftCalc();
  }

  function resetToOriginalPlannedTimes() {
    if (!currentEditingShift) return;
    const origStart = currentEditingShift.originalPlannedStartTime || currentEditingShift.startTime || '12:00';
    const origEnd = currentEditingShift.originalPlannedEndTime || currentEditingShift.endTime || '21:00';
    document.getElementById('editStartTime').value = origStart;
    document.getElementById('editEndTime').value = origEnd;
    updateEditShiftCalc();
  }

  function closeEditShiftModal() {
    document.getElementById('editShiftModal').classList.add('hidden');
  }

  function openConfirmDeleteShiftModal(shiftId, detailsText) {
    const modal = document.getElementById('deleteShiftModal');
    const form = document.getElementById('deleteShiftForm');
    const text = document.getElementById('deleteShiftDetailsText');
    if (form) form.action = `/admin/staff-schedule/delete/${shiftId}`;
    if (text) text.textContent = detailsText || 'arbetspasset';
    if (modal) modal.classList.remove('hidden');
  }

  function closeDeleteShiftModal() {
    const modal = document.getElementById('deleteShiftModal');
    if (modal) modal.classList.add('hidden');
  }

  function triggerDeleteCurrentShift() {
    if (!currentEditingShift) return;
    const shiftId = currentEditingShift.id;
    const details = `${currentEditingShift.shiftName || 'Arbetspass'} (${currentEditingShift.startTime}–${currentEditingShift.endTime})`;
    closeEditShiftModal();
    openConfirmDeleteShiftModal(shiftId, details);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDeleteShiftModal();
    }
  });
</script>

