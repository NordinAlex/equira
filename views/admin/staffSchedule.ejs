          <input type="time" name="startTime" id="editStartTime" required onchange="updateEditShiftCalc()" class="w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-700">
