<div class="px-4 sm:px-6 lg:px-8 py-6 max-w-7xl mx-auto space-y-6">

  <!-- Top Breadcrumb & Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-stone-500 font-medium uppercase tracking-wider mb-1">
        <a href="/admin/overview" class="hover:text-emerald-800">Admin</a>
        <span>/</span>
        <a href="/admin/staff" class="hover:text-emerald-800">Personal</a>
        <span>/</span>
        <span class="text-stone-800 font-bold">Personalschema</span>
      </div>
      <h1 class="text-2xl md:text-3xl font-extrabold text-stone-900 tracking-tight flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-800 text-white flex items-center justify-center text-lg shadow-sm">
          <i class="fa-solid fa-calendar-week"></i>
        </div>
        <span>Personalschema & Schemaläggning</span>
      </h1>
      <p class="text-xs md:text-sm text-stone-500 mt-1">
        Planera arbetspass, tilldela tider och hantera stallpersonalens månads- och veckoscheman.
      </p>
    </div>

    <!-- Top Action Buttons -->
    <div class="flex items-center gap-2.5 flex-wrap">
      <button type="button" 
              onclick="openQuickWeekModal()"
              class="px-3.5 py-2 bg-white hover:bg-stone-50 text-stone-700 border border-stone-300 rounded-xl text-xs font-semibold shadow-xs flex items-center gap-2 transition hover-lift">
        <i class="fa-solid fa-bolt text-amber-600"></i>
        <span>Snabbplanera vecka</span>
      </button>

      <button type="button" 
              onclick="openCreateShiftModal()"
              class="px-4 py-2 bg-emerald-800 hover:bg-emerald-900 text-white rounded-xl text-xs font-semibold shadow-xs flex items-center gap-2 transition hover-lift">
        <i class="fa-solid fa-plus text-xs"></i>
        <span>Nytt arbetspass</span>
      </button>
    </div>
  </div>

  <!-- Success / Error Alert Banners -->
  <% if (locals.success) { %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm rounded-2xl flex items-center justify-between shadow-xs">
      <div class="flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-emerald-600 text-base"></i>
        <span><%= success %></span>
      </div>
      <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 cursor-pointer">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>
  <% } %>

  <% if (locals.error) { %>
    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm rounded-2xl flex items-center justify-between shadow-xs">
      <div class="flex items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation text-rose-600 text-base"></i>
        <span><%= error %></span>
      </div>
      <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 cursor-pointer">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>
  <% } %>

  <!-- KPI / Stats Overview Row -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <!-- Total Hours -->
    <div class="bg-white rounded-2xl border border-stone-200 p-5 shadow-xs flex items-center justify-between">
      <div>
        <span class="text-[10px] font-bold tracking-wider uppercase text-stone-400">PLANERAD TID DENNA MÅNAD</span>
        <p class="text-2xl md:text-3xl font-black text-stone-900 mt-0.5"><%= data.totalPlannedHours || 144 %> tim</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-800 flex items-center justify-center text-lg border border-emerald-100">
        <i class="fa-regular fa-clock"></i>
      </div>
    </div>

    <!-- Shifts Count -->
    <div class="bg-white rounded-2xl border border-stone-200 p-5 shadow-xs flex items-center justify-between">
      <div>
        <span class="text-[10px] font-bold tracking-wider uppercase text-stone-400">SCHEMALAGDA ARBETSPASS</span>
        <p class="text-2xl md:text-3xl font-black text-stone-900 mt-0.5"><%= data.totalShiftsCount || 18 %> pass</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-800 flex items-center justify-center text-lg border border-blue-100">
        <i class="fa-solid fa-calendar-check"></i>
      </div>
    </div>

    <!-- Active Staff Count -->
    <div class="bg-white rounded-2xl border border-stone-200 p-5 shadow-xs flex items-center justify-between">
      <div>
        <span class="text-[10px] font-bold tracking-wider uppercase text-stone-400">TILLGÄNGLIG PERSONAL</span>
        <p class="text-2xl md:text-3xl font-black text-stone-900 mt-0.5"><%= data.staffUsers ? data.staffUsers.length : 3 %> anställda</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-800 flex items-center justify-center text-lg border border-amber-100">
        <i class="fa-solid fa-users"></i>
      </div>
    </div>
  </div>

  <!-- Filter & Month Navigation Bar -->
  <div class="bg-white rounded-2xl border border-stone-200/90 p-4 shadow-xs flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <!-- Month Navigation -->
    <div class="flex items-center gap-3">
      <span class="text-xs font-bold text-stone-500 uppercase tracking-wide">Månad:</span>
      <div class="inline-flex items-center bg-stone-100 rounded-xl p-1 border border-stone-200">
        <a href="/admin/staff-schedule?month=<%= data.prevMonthKey %><%= data.selectedUserId ? '&staffId=' + data.selectedUserId : '' %>" 
           title="Föregående månad"
           class="w-7 h-7 flex items-center justify-center text-stone-600 hover:text-stone-900 hover:bg-white rounded-lg transition">
          <i class="fa-solid fa-chevron-left text-xs"></i>
        </a>
        <span class="px-4 text-xs font-bold text-stone-900">
          <%= data.monthLabel %>
        </span>
        <a href="/admin/staff-schedule?month=<%= data.nextMonthKey %><%= data.selectedUserId ? '&staffId=' + data.selectedUserId : '' %>" 
           title="Nästa månad"
           class="w-7 h-7 flex items-center justify-center text-stone-600 hover:text-stone-900 hover:bg-white rounded-lg transition">
          <i class="fa-solid fa-chevron-right text-xs"></i>
        </a>
      </div>
      <% if (!data.hasCurrentWeek) { %>
        <a href="/admin/staff-schedule<%= data.selectedUserId ? '?staffId=' + data.selectedUserId : '' %>" 
           title="Gå till aktuell månad och vecka"
           class="px-2.5 py-1 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-semibold hover:bg-emerald-100 transition flex items-center gap-1.5 shadow-2xs">
          <i class="fa-solid fa-calendar-check text-[11px]"></i>
          <span>Denna vecka</span>
        </a>
      <% } %>
    </div>

    <!-- Staff Filter Dropdown -->
    <div class="flex items-center gap-2">
      <span class="text-xs font-bold text-stone-500 uppercase tracking-wide">Filtrera personal:</span>
      <form action="/admin/staff-schedule" method="GET" class="flex items-center gap-2">
        <input type="hidden" name="month" value="<%= data.monthKey %>">
        <select name="staffId" onchange="this.form.submit()" class="bg-stone-50 border border-stone-200 text-stone-800 text-xs rounded-xl px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-emerald-700">
          <option value="">Alla i personalen</option>
          <% (data.staffUsers || []).forEach(staff => { %>
            <option value="<%= staff.id %>" <%= (data.selectedUserId === staff.id) ? 'selected' : '' %>>
              <%= staff.fullName %> (<%= staff.title %>)
            </option>
          <% }); %>
        </select>
        <% if (data.selectedUserId) { %>
          <a href="/admin/staff-schedule?month=<%= data.monthKey %>" class="text-xs text-stone-400 hover:text-stone-700 underline">Återställ</a>
        <% } %>
      </form>
    </div>
  </div>

  <!-- WEEKS SCHEDULE MATRIX -->
  <div class="space-y-6">
    <% (data.weeks || []).forEach(week => { %>
      <div <%= week.isCurrentWeek ? 'id="currentWeekCard"' : '' %> class="bg-white rounded-2xl md:rounded-3xl border <%= week.isCurrentWeek ? 'border-emerald-300 ring-2 ring-emerald-600/10' : 'border-stone-200/90' %> shadow-sm overflow-hidden">
        
        <!-- Week Header Bar -->
        <div class="px-5 py-3.5 bg-stone-50/80 border-b border-stone-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <div class="flex items-center gap-3">
            <span class="px-2.5 py-1 rounded-lg <%= week.isCurrentWeek ? 'bg-emerald-800 text-white font-bold' : 'bg-stone-200 text-stone-800 font-semibold' %> text-xs">
              Vecka <%= week.weekNumber %>
            </span>
            <span class="text-xs text-stone-500 font-medium">
              <%= week.days[0].dateStr %> – <%= week.days[6].dateStr %>
            </span>
            <% if (week.isCurrentWeek) { %>
              <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-full">
                Denna vecka
              </span>
            <% } %>
          </div>

          <div class="flex items-center gap-2">
            <button type="button" 
                    onclick="openQuickWeekModalWithDate('<%= week.mondayDateStr %>')"
                    class="text-xs text-emerald-800 hover:text-emerald-950 font-semibold flex items-center gap-1 hover:underline">
              <i class="fa-solid fa-bolt text-[11px] text-amber-600"></i>
              <span>Planera V.<%= week.weekNumber %></span>
            </button>
          </div>
        </div>

        <!-- Scrollable Table Wrapper -->
        <div class="overflow-x-auto">
          <div class="min-w-[800px]">
            
            <!-- Day Column Titles Row -->
            <div class="grid grid-cols-12 gap-2 px-5 py-2.5 border-b border-stone-100 text-center text-xs font-semibold text-stone-600 bg-stone-50/30">
              <div class="col-span-3 text-left">Personal & Roll</div>
              <div class="col-span-9 grid grid-cols-7 gap-2">
                <% week.days.forEach(day => { %>
                  <div class="<%= day.isSunday ? 'text-[#e11d48]' : (day.isToday ? 'text-emerald-800 font-bold' : 'text-stone-700') %> leading-tight">
                    <div><%= day.dayName %></div>
                    <div class="text-[11px] font-normal"><%= day.dateStr %></div>
                  </div>
                <% }); %>
              </div>
            </div>

            <!-- Staff Rows -->
            <div class="divide-y divide-stone-100">
              <% (week.staffRows || []).forEach(row => { %>
                <div class="grid grid-cols-12 gap-2 px-5 py-3 items-center hover:bg-stone-50/40 transition">
                  
                  <!-- Left: Staff Profile & Weekly hours -->
                  <div class="col-span-3 flex items-center justify-between pr-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <img src="<%= row.user.avatarUrl %>" alt="<%= row.user.fullName %>" class="w-8 h-8 rounded-full object-cover border border-stone-200 flex-shrink-0">
                      <div class="min-w-0">
                        <h4 class="text-xs font-bold text-stone-900 truncate leading-tight"><%= row.user.fullName %></h4>
                        <p class="text-[10px] text-stone-400 truncate"><%= row.user.title %></p>
                      </div>
                    </div>
                    <span class="px-2 py-0.5 rounded border border-stone-200 text-stone-600 text-[10px] font-medium bg-white flex-shrink-0">
                      <%= row.weekHours %> tim
                    </span>
                  </div>

                  <!-- Right: 7 Days Shift Slots -->
                  <div class="col-span-9 grid grid-cols-7 gap-2">
                    <% row.days.forEach(day => { %>
                      <div class="min-h-[56px] rounded-xl border border-stone-100 p-1.5 flex flex-col justify-center items-center relative group transition <%= day.shifts.length > 0 ? (day.shifts.some(s => s.isClockedIn) ? 'bg-emerald-50/70 border-emerald-300' : (day.shifts.some(s => s.isAdjusted) ? 'bg-amber-50/60 border-amber-300' : 'bg-[#0088d1]/10 border-[#0088d1]/30')) : 'bg-stone-50/30 hover:border-stone-300' %>">
                        
                        <% if (day.shifts.length > 0) { %>
                          <% day.shifts.forEach(shift => { %>
                            <div class="w-full text-center space-y-0.5 cursor-pointer"
                                 data-shift='<%- JSON.stringify(shift) %>'
                                 onclick="if(!event.target.closest('button')) openEditShiftModal(JSON.parse(this.dataset.shift))">
                              
                              <!-- Shift time display & struck-through original if adjusted -->
                              <div class="flex items-center justify-center gap-1 flex-wrap">
                                <span class="text-[11px] font-bold text-[#005a9c] leading-tight">
                                  <%= shift.startTime %> – <%= shift.endTime %>
                                </span>
                                <% if (shift.isAdjusted && (shift.originalPlannedStartTime !== shift.startTime || shift.originalPlannedEndTime !== shift.endTime)) { %>
                                  <span class="text-[8.5px] text-stone-400 font-medium" title="Ursprungligt planerat pass: <%= shift.originalPlannedStartTime %>–<%= shift.originalPlannedEndTime %>">
                                    (orig: <span class="line-through"><%= shift.originalPlannedStartTime %>–<%= shift.originalPlannedEndTime %></span>)
                                  </span>
                                <% } %>
                              </div>

                              <!-- Stamping & Status Indicators -->
                              <div class="flex items-center justify-center gap-1 flex-wrap pt-0.5">
                                <% if (shift.isClockedIn) { %>
                                  <span class="inline-flex items-center gap-1 text-[8.5px] font-bold text-emerald-800 bg-emerald-100/90 px-1.5 py-0.5 rounded-full border border-emerald-300 shadow-2xs" title="Personal är instämplad sedan <%= shift.checkInTimeStr %>">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> In <%= shift.checkInTimeStr %>
                                  </span>
                                <% } else if (shift.checkInTimeStr && shift.checkInTimeStr !== '–' && shift.checkOutTimeStr && shift.checkOutTimeStr !== '–') { %>
                                  <span class="inline-flex items-center gap-1 text-[8.5px] font-semibold text-sky-800 bg-sky-100/80 px-1.5 py-0.5 rounded-md border border-sky-200" title="Personal stämplade: <%= shift.checkInTimeStr %>–<%= shift.checkOutTimeStr %> (Original: <%= shift.originalCheckInTimeStr %>–<%= shift.originalCheckOutTimeStr %>)">
                                    <i class="fa-solid fa-fingerprint text-[7.5px] text-sky-600"></i> <%= shift.checkInTimeStr %>–<%= shift.checkOutTimeStr %>
                                  </span>
                                <% } else { %>
                                  <span class="text-[9px] text-stone-500 font-medium truncate">
                                    <%= shift.hours %>h &bull; <%= shift.location %>
                                  </span>
                                <% } %>

                                <% if (shift.isAdjusted) { %>
                                  <span class="inline-flex items-center gap-0.5 text-[8px] font-bold text-amber-800 bg-amber-100/90 px-1 py-0.5 rounded border border-amber-300" title="Justerad av <%= shift.adjustedBy || 'Admin' %><%= shift.adjustedAtStr ? ' kl ' + shift.adjustedAtStr : '' %>">
                                    <i class="fa-solid fa-pen-nib text-[6.5px] text-amber-600"></i> Justerad
                                  </span>
                                <% } %>
                              </div>

                              <!-- Quick Edit / Delete Buttons on Hover -->
                              <div class="absolute inset-0 bg-stone-900/80 rounded-xl flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition z-10">
                                <button type="button" 
                                        data-shift='<%- JSON.stringify(shift) %>'
                                        onclick="openEditShiftModal(JSON.parse(this.dataset.shift))"
                                        title="Redigera pass och se stämplingar"
                                        class="w-7 h-7 rounded-lg bg-white/20 hover:bg-white text-white hover:text-stone-900 flex items-center justify-center text-xs transition cursor-pointer">
                                  <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button type="button" 
                                        data-id="<%= shift.id %>"
                                        data-details="<%= (shift.shiftName || 'Arbetspass') %> den <%= shift.dateStr || '' %> (<%= shift.startTime %>–<%= shift.endTime %> för <%= row.user.fullName || '' %>)"
                                        onclick="openConfirmDeleteShiftModal(this.dataset.id, this.dataset.details)"
                                        title="Ta bort pass"
                                        class="w-7 h-7 rounded-lg bg-rose-500/80 hover:bg-rose-600 text-white flex items-center justify-center text-xs transition cursor-pointer">
                                  <i class="fa-solid fa-trash"></i>
                                </button>
                              </div>
                            </div>
                          <% }); %>
                        <% } else { %>
                          <!-- Empty day slot: Quick + button -->
                          <button type="button" 
                                  onclick="openCreateShiftModalWithParams('<%= row.user.id %>', '<%= day.fullDate %>')"
                                  title="Schemalägg pass för <%= row.user.fullName %>"
                                  class="w-full h-full flex items-center justify-center text-stone-300 hover:text-emerald-700 opacity-0 group-hover:opacity-100 transition">
                            <i class="fa-solid fa-plus text-xs"></i>
                          </button>
                        <% } %>

                      </div>
                    <% }); %>
                  </div>

                </div>
              <% }); %>
            </div>

          </div>
        </div>

      </div>
    <% }); %>
  </div>

</div>

<!-- MODAL 1: CREATE SINGLE SHIFT -->
<div id="createShiftModal" class="fixed inset-0 bg-stone-900/60 backdrop-blur-xs flex items-center justify-center p-4 z-50 hidden transition-opacity">
  <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-stone-200 space-y-5 animate-in fade-in zoom-in-95 duration-150">
    <div class="flex items-center justify-between border-b border-stone-100 pb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-emerald-800 text-white flex items-center justify-center text-sm shadow-xs">
          <i class="fa-solid fa-plus"></i>
        </div>
        <h3 class="text-base font-bold text-stone-900">Schemalägg nytt arbetspass</h3>
      </div>
      <button type="button" onclick="closeCreateShiftModal()" class="w-8 h-8 rounded-full hover:bg-stone-100 text-stone-400 hover:text-stone-700 flex items-center justify-center transition">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>

    <form action="/admin/staff-schedule/create" method="POST" class="space-y-4 text-xs">
      <div>
        <label class="block font-semibold text-stone-700 mb-1">Personal *</label>
        <select name="userId" id="createShiftUserId" required class="w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-700">
          <% (data.staffUsers || []).forEach(staff => { %>
            <option value="<%= staff.id %>"><%= staff.fullName %> (<%= staff.title %>)</option>
          <% }); %>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-semibold text-stone-700 mb-1">Datum *</label>
          <input type="date" name="date" id="createShiftDate" required value="<%= data.todayStr %>" class="w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-700">
        </div>
        <div>
          <label class="block font-semibold text-stone-700 mb-1">Passnamn / Roll</label>
          <input type="text" name="shiftName" value="Stallpersonal (6851)" class="w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-700">
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block font-semibold text-stone-700 mb-1">Starttid *</label>
          <input type="time" name="startTime" id="createStartTime" value="12:00" required onchange="updateCreateShiftCalc()" class="w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-700">
        </div>
        <div>
          <label class="block font-semibold text-stone-700 mb-1">Sluttid *</label>
          <input type="time" name="endTime" id="createEndTime" value="21:00" required onchange="updateCreateShiftCalc()" class="w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-700">
        </div>
        <div>
          <label class="block font-semibold text-stone-700 mb-1">Arbetstid (timmar)</label>
          <input type="number" step="0.5" name="hours" id="createHours" value="8.0" class="w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-700">
        </div>
      </div>

      <div class="p-2.5 bg-emerald-50/70 border border-emerald-200/70 rounded-xl flex items-center justify-between text-[11px] text-emerald-900">
        <span class="flex items-center gap-1.5 font-medium">
          <i class="fa-solid fa-mug-hot text-emerald-700"></i>
          <span id="createBreakHint">Beräknad rast från pass: <strong>1 rast (01:00)</strong></span>
        </span>
        <span class="text-stone-500" id="createElapsedHint">Passlängd: 9 tim</span>
      </div>

      <div>
        <label class="block font-semibold text-stone-700 mb-1">Placering / Anläggning</label>
        <input type="text" name="location" value="Huvudstallet" class="w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-700">
      </div>

      <div>
        <label class="block font-semibold text-stone-700 mb-1">Notering / Instruktion</label>
        <textarea name="note" rows="2" placeholder="T.ex. Helgfodring eller hästskötsel..." class="w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-700"></textarea>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-stone-100">
        <button type="button" onclick="closeCreateShiftModal()" class="px-4 py-2 border border-stone-300 hover:bg-stone-50 text-stone-700 rounded-xl font-semibold transition">Avbryt</button>
        <button type="submit" class="px-5 py-2 bg-emerald-800 hover:bg-emerald-900 text-white rounded-xl font-semibold shadow-xs transition">Spara arbetspass</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL 2: QUICK PLAN STANDARD WEEK (Mån–Fre) -->
<div id="quickWeekModal" class="fixed inset-0 bg-stone-900/60 backdrop-blur-xs flex items-center justify-center p-4 z-50 hidden transition-opacity">
  <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-stone-200 space-y-5 animate-in fade-in zoom-in-95 duration-150">
    <div class="flex items-center justify-between border-b border-stone-100 pb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-amber-600 text-white flex items-center justify-center text-sm shadow-xs">
          <i class="fa-solid fa-bolt"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-stone-900">Snabbplanera hel vecka</h3>
          <p class="text-[11px] text-stone-500">Skapar 5 pass automatiskt (Mån–Fre 40 tim)</p>
        </div>
      </div>
      <button type="button" onclick="closeQuickWeekModal()" class="w-8 h-8 rounded-full hover:bg-stone-100 text-stone-400 hover:text-stone-700 flex items-center justify-center transition">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>

    <form action="/admin/staff-schedule/quick-week" method="POST" class="space-y-4 text-xs">
      <div>
        <label class="block font-semibold text-stone-700 mb-1">Välj personal *</label>
        <select name="userId" required class="w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-700">
