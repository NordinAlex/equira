<div class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8 space-y-6">

  <% if (success) { %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl flex items-center gap-3">
      <i class="fa-solid fa-circle-check text-emerald-500"></i>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl flex items-center gap-3">
      <i class="fa-solid fa-triangle-exclamation text-rose-500"></i>
      <span><%= error %></span>
    </div>
  <% } %>


  <!-- Tillbaka -->
  <a
    href="/admin/horses"
    class="inline-flex items-center gap-2 text-sm font-medium text-stone-600 hover:text-stone-900 transition"
  >
    <i class="fa-solid fa-arrow-left"></i>
    Tillbaka till hästar
  </a>


  <!-- HERO -->
  <div class="bg-white rounded-3xl border border-stone-200 shadow-sm overflow-hidden">

    <div class="relative h-[350px] sm:h-[450px]">

      <img
        src="<%= horse.photoUrl %>"
        alt="<%= horse.name %>"
        class="w-full h-full object-cover"
      >

      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>

      <div class="absolute bottom-6 left-6 right-6 text-white">

        <div class="flex items-end justify-between gap-4">

          <div>

            <h1 class="text-3xl sm:text-4xl font-bold drop-shadow-lg">
              <%= horse.name %>
            </h1>

            <div class="flex flex-wrap gap-2 mt-3">

              <span class="bg-black/30 backdrop-blur-md px-3 py-2 rounded-full text-sm">
                <%= new Date().getFullYear() - horse.birthYear %> år
              </span>

              <span class="bg-black/30 backdrop-blur-md px-3 py-2 rounded-full text-sm">
                <%= horse.breed %>
              </span>

              <% if (horse.status) { %>
                <span class="bg-black/30 backdrop-blur-md px-3 py-2 rounded-full text-sm">
                  <%= horse.status %>
                </span>
              <% } %>

            </div>

          </div>

          <a
            href="/admin/horses/<%= horse.id %>/edit"
            class="shrink-0 inline-flex items-center gap-2 bg-white text-stone-800 px-4 py-2.5 rounded-xl font-semibold text-sm shadow-lg hover:bg-stone-100 transition"
          >
            <i class="fa-solid fa-pen"></i>
            Redigera
          </a>

        </div>

      </div>

    </div>


    <!-- Hästinfo -->

    <div class="p-6 sm:p-8">

      <h2 class="text-2xl font-semibold text-stone-900">
        Om <%= horse.name %>
      </h2>

      <% if (horse.description) { %>
        <p class="mt-4 text-stone-600 leading-relaxed">
          <%= horse.description %>
        </p>
      <% } %>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6">

        <div class="bg-stone-50 rounded-xl p-4">
          <p class="text-xs uppercase font-bold text-stone-400">
            Box
          </p>
          <p class="font-semibold text-stone-800 mt-1">
            <%= horse.boxNumber || '-' %>
          </p>
        </div>

        <div class="bg-stone-50 rounded-xl p-4">
          <p class="text-xs uppercase font-bold text-stone-400">
            Hage
          </p>
          <p class="font-semibold text-stone-800 mt-1">
            <%= horse.paddockNumber || '-' %>
          </p>
        </div>

        <div class="bg-stone-50 rounded-xl p-4">
          <p class="text-xs uppercase font-bold text-stone-400">
            Höjd
          </p>
          <p class="font-semibold text-stone-800 mt-1">
            <%= horse.heightCm || '-' %> cm
          </p>
        </div>

        <div class="bg-stone-50 rounded-xl p-4">
          <p class="text-xs uppercase font-bold text-stone-400">
            Maxvikt
          </p>
          <p class="font-semibold text-stone-800 mt-1">
            <%= horse.maxRiderWeightKg || '-' %> kg
          </p>
        </div>

      </div>

    </div>

  </div>


  <!-- BESKRIVNINGAR -->

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <% if (horse.temperamentDescription) { %>
      <div class="bg-white rounded-2xl border border-stone-200 p-6 shadow-sm">

        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-xl bg-stone-100 flex items-center justify-center">
            <i class="fa-solid fa-heart text-stone-600"></i>
          </div>

          <h3 class="text-xl font-semibold">
            Temperament
          </h3>
        </div>

        <p class="text-stone-600 leading-relaxed">
          <%= horse.temperamentDescription %>
        </p>

      </div>
    <% } %>


    <% if (horse.ridingDescription) { %>
      <div class="bg-white rounded-2xl border border-stone-200 p-6 shadow-sm">

        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-xl bg-stone-100 flex items-center justify-center">
            <i class="fa-solid fa-horse text-stone-600"></i>
          </div>

          <h3 class="text-xl font-semibold">
            Ridning
          </h3>
        </div>

        <p class="text-stone-600 leading-relaxed">
          <%= horse.ridingDescription %>
        </p>

      </div>
    <% } %>

  </div>


  <!-- VIKTIG INFORMATION -->

  <% if (horse.importantInfo) { %>

    <div class="bg-amber-50 rounded-2xl border border-amber-200 p-6">

      <div class="flex items-center gap-3">

        <i class="fa-solid fa-circle-info text-amber-600 text-xl"></i>

        <h3 class="text-xl font-semibold text-stone-900">
          Viktig information
        </h3>

      </div>

      <p class="mt-4 text-stone-700 leading-relaxed">
        <%= horse.importantInfo %>
      </p>

    </div>

  <% } %>


  <!-- ========================= -->
  <!-- ÅTGÄRDER -->
  <!-- ========================= -->

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Befintliga åtgärder -->

    <div class="lg:col-span-2 bg-white rounded-2xl border border-stone-200 shadow-sm">

      <div class="p-6 border-b border-stone-100">

        <div class="flex items-center justify-between">

          <div>

            <h2 class="text-2xl font-semibold text-stone-900">
              Åtgärder
            </h2>

            <p class="text-sm text-stone-500 mt-1">
              Uppgifter kopplade till <%= horse.name %>
            </p>

          </div>

          <div class="w-10 h-10 rounded-xl bg-stone-100 flex items-center justify-center">
            <i class="fa-solid fa-list-check text-stone-600"></i>
          </div>

        </div>

      </div>


      <div class="p-6 space-y-3">

        <% if (!tasks || tasks.length === 0) { %>

          <div class="text-center py-10 text-stone-400">

            <i class="fa-solid fa-clipboard-check text-3xl mb-3"></i>

            <p class="font-medium">
              Inga åtgärder finns för denna häst.
            </p>

            <p class="text-sm mt-1">
              Lägg till en åtgärd med formuläret.
            </p>

          </div>

        <% } else { %>

          <% tasks.forEach(task => { %>

            <div class="border border-stone-200 rounded-xl p-4">

              <div class="flex items-start justify-between gap-4">

                <div>

                  <div class="flex items-center gap-2">

                    <h3 class="font-semibold text-stone-900">
                      <%= task.title %>
                    </h3>

                    <% if (task.status) { %>
                      <span class="px-2 py-1 rounded-full text-[10px] font-semibold bg-stone-100 text-stone-600">
                        <%= task.status %>
                      </span>
                    <% } %>

                  </div>

                  <div class="flex flex-wrap gap-3 mt-2 text-xs text-stone-500">

                    <% if (task.taskType) { %>
                      <span>
                        <i class="fa-solid fa-tag mr-1"></i>
                        <%= task.taskType %>
                      </span>
                    <% } %>

                    <% if (task.dueDate) { %>
                      <span>
                        <i class="fa-regular fa-calendar mr-1"></i>
                        <%= task.dueDate %>
                      </span>
                    <% } %>

                    <% if (task.dueTime) { %>
                      <span>
                        <i class="fa-regular fa-clock mr-1"></i>
                        <%= task.dueTime %>
                      </span>
                    <% } %>

                    <% if (task.priority) { %>
                      <span>
                        <i class="fa-solid fa-flag mr-1"></i>
                        <%= task.priority %>
                      </span>
                    <% } %>

                  </div>

                  <% if (task.instructions) { %>

                    <p class="text-sm text-stone-600 mt-3">
                      <%= task.instructions %>
                    </p>

                  <% } %>

                </div>

                <a
                  href="/admin/tasks/<%= task.id %>/edit"
                  class="shrink-0 text-stone-400 hover:text-stone-700"
                  title="Redigera åtgärd"
                >
                  <i class="fa-solid fa-pen"></i>
                </a>

              </div>

            </div>

          <% }); %>

        <% } %>

      </div>

    </div>


    <!-- Lägg till åtgärd -->

    <div class="bg-white rounded-2xl border border-stone-200 shadow-sm">

      <div class="p-6 border-b border-stone-100">

        <h2 class="text-xl font-semibold text-stone-900">
          Lägg till åtgärd
        </h2>

        <p class="text-sm text-stone-500 mt-1">
          Skapa en uppgift för <%= horse.name %>.
        </p>

      </div>


      <form
        action="/admin/horses/<%= horse.id %>/tasks"
        method="POST"
        class="p-6 space-y-4"
      >

        <div>
          <label for="horseTaskTitle" class="block text-sm font-medium text-stone-700 mb-1">
            Åtgärd
          </label>
          <input
            id="horseTaskTitle"
            type="text"
            name="title"
            required
            placeholder="Ex. Mocka box"
            class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-stone-300"
          >
        </div>

        <div>
          <label for="horseTaskType" class="block text-sm font-medium text-stone-700 mb-1">
            Typ
          </label>
          <select
            id="horseTaskType"
            name="taskType"
            class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm bg-white"
          >
            <option value="Morgonfodring">Morgonfodring</option>
            <option value="Fodring">Fodring</option>
            <option value="Utsläpp">Utsläpp</option>
            <option value="Mockning">Mockning</option>
            <option value="Kontroll">Kontroll</option>
            <option value="Övrigt">Övrigt</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="horseTaskDueDate" class="block text-sm font-medium text-stone-700 mb-1">
              Datum
            </label>
            <input
              id="horseTaskDueDate"
              type="date"
              name="dueDate"
              value="<%= new Date().toISOString().split('T')[0] %>"
              class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm"
            >
          </div>

          <div>
            <label for="horseTaskDueTime" class="block text-sm font-medium text-stone-700 mb-1">
              Tid
            </label>
            <input
              id="horseTaskDueTime"
              type="time"
              name="dueTime"
              value="07:00"
              class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm"
            >
          </div>
        </div>

        <div>
          <label for="horseTaskPriority" class="block text-sm font-medium text-stone-700 mb-1">
            Prioritet
          </label>
          <select
            id="horseTaskPriority"
            name="priority"
            class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm bg-white"
          >
            <option value="Normal">Normal</option>
            <option value="Hög">Hög</option>
            <option value="Akut">Akut</option>
          </select>
        </div>

        <div>
          <label for="horseTaskInstructions" class="block text-sm font-medium text-stone-700 mb-1">
            Instruktioner
          </label>
          <textarea
            id="horseTaskInstructions"
            name="instructions"
            rows="4"
            placeholder="Beskriv vad som ska göras..."
            class="w-full rounded-xl border border-stone-200 px-4 py-3 text-sm resize-none"
          ></textarea>
        </div>


        <button
          type="submit"
          class="w-full inline-flex items-center justify-center gap-2 bg-[#3d2314] hover:bg-[#2c190e] text-white px-5 py-3 rounded-xl font-semibold text-sm transition"
        >
          <i class="fa-solid fa-plus"></i>
          Lägg till åtgärd
        </button>

      </form>

    </div>

  </div>

</div>