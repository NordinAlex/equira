<div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <div class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Schema & Planering</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight mt-1">Veckoschema</h2>
      <p class="text-xs sm:text-sm text-stone-500 mt-1">Överblick över anläggningens ridbanor, lektionspass och hästtilldelningar.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <!-- View mode toggle: Vecka / Dag -->
      <div class="inline-flex rounded-xl p-1 bg-stone-200 text-xs font-semibold">
        <a href="<%= data.weekInfo.weekViewUrl %>" class="px-3 py-1.5 rounded-lg transition <%= data.currentView === 'week' ? 'bg-white shadow-xs text-stone-900 font-bold' : 'text-stone-600 hover:text-stone-900' %>">
          <i class="fa-regular fa-calendar mr-1"></i> Vecka
        </a>
        <a href="<%= data.weekInfo.dayViewUrl %>" class="px-3 py-1.5 rounded-lg transition <%= data.currentView === 'day' ? 'bg-white shadow-xs text-stone-900 font-bold' : 'text-stone-600 hover:text-stone-900' %>">
          <i class="fa-regular fa-calendar-days mr-1"></i> Dag
        </a>
      </div>

      <!-- New Lesson Button -->
      <a href="/admin/lessons/create" class="inline-flex items-center gap-2 bg-[#3d2314] hover:bg-[#2c190e] text-white px-4 sm:px-5 py-2 sm:py-2.5 rounded-xl font-medium text-xs sm:text-sm shadow-sm transition hover-lift">
        <i class="fa-solid fa-plus text-xs"></i>
        <span>Ny Lektion</span>
      </a>
    </div>
  </div>

  <!-- Week Navigation & Filter Toolbar -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-stone-200 shadow-xs">
    <!-- Left: Week Navigator -->
    <div class="flex flex-wrap items-center gap-2.5">
      <div class="inline-flex items-center bg-stone-100 border border-stone-200 rounded-xl p-0.5 text-xs font-semibold">
        <a href="<%= data.weekInfo.prevWeekUrl %>" title="Föregående vecka" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white text-stone-600 transition">
          <i class="fa-solid fa-chevron-left text-[11px]"></i>
        </a>
        <span class="px-3 text-stone-800 font-bold flex items-center gap-1.5">
          <span><%= data.weekInfo.label %></span>
          <span class="text-stone-400 font-normal hidden sm:inline">(<%= data.weekInfo.dateRangeLabel %>)</span>
        </span>
        <a href="<%= data.weekInfo.nextWeekUrl %>" title="Nästa vecka" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white text-stone-600 transition">
          <i class="fa-solid fa-chevron-right text-[11px]"></i>
        </a>
      </div>

      <!-- Jump to Today button if not current week -->
      <% if (!data.weekInfo.isCurrentWeek) { %>
        <a href="<%= data.weekInfo.todayUrl %>" class="px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-semibold hover:bg-emerald-100 transition flex items-center gap-1">
          <i class="fa-solid fa-calendar-check text-[11px]"></i>
          <span>Denna vecka</span>
        </a>
      <% } else { %>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Aktuell vecka
        </span>
      <% } %>
    </div>

    <!-- Right: Arena Filter Pills -->
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="text-xs font-semibold text-stone-400 mr-1 hidden sm:inline">
        <i class="fa-solid fa-location-dot text-[10px] mr-1"></i>Arena:
      </span>
      <a href="<%= data.allArenasUrl %>" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition <%= !data.selectedArenaId ? 'bg-[#1B3B2B] text-white shadow-xs' : 'bg-stone-50 border border-stone-200 text-stone-600 hover:bg-stone-100' %>">
        Alla arenor
      </a>
      <% data.arenas.forEach(arena => { %>
        <a href="<%= arena.filterUrl %>" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition <%= arena.isSelected ? 'bg-[#1B3B2B] text-white shadow-xs' : 'bg-stone-50 border border-stone-200 text-stone-600 hover:bg-stone-100' %>">
          <%= arena.name %>
        </a>
      <% }) %>
    </div>
  </div>

  <!-- Weekly KPIs Bar -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    <div class="bg-white p-4 rounded-2xl border border-stone-200 shadow-xs flex items-center justify-between">
      <div>
        <p class="text-[10px] sm:text-[11px] font-bold text-stone-400 uppercase tracking-wider">Lektioner i veckan</p>
        <p class="text-xl sm:text-2xl font-black text-stone-900 mt-0.5"><%= data.kpis.totalLessons %> <span class="text-xs font-normal text-stone-500">pass</span></p>
      </div>
      <div class="w-9 h-9 rounded-xl bg-stone-100 flex items-center justify-center text-stone-600 shrink-0">
        <i class="fa-solid fa-calendar-week text-sm"></i>
      </div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-stone-200 shadow-xs flex items-center justify-between">
      <div>
        <p class="text-[10px] sm:text-[11px] font-bold text-stone-400 uppercase tracking-wider">Inskrivna elever</p>
        <p class="text-xl sm:text-2xl font-black text-stone-900 mt-0.5"><%= data.kpis.totalBookings %> <span class="text-xs font-normal text-stone-500">/ <%= data.kpis.totalCapacity %></span></p>
        <p class="text-[10px] text-emerald-600 font-semibold"><%= data.kpis.fillPercentage %>% beläggning</p>
      </div>
      <div class="w-9 h-9 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 shrink-0">
        <i class="fa-solid fa-user-group text-sm"></i>
      </div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-stone-200 shadow-xs flex items-center justify-between <%= data.kpis.unassignedLessonsCount > 0 ? 'bg-amber-50/40 border-amber-200' : '' %>">
      <div>
        <p class="text-[10px] sm:text-[11px] font-bold text-stone-400 uppercase tracking-wider">Hästtilldelning</p>
        <% if (data.kpis.unassignedLessonsCount > 0) { %>
          <p class="text-xl sm:text-2xl font-black text-amber-700 mt-0.5"><%= data.kpis.unassignedLessonsCount %> <span class="text-xs font-normal text-amber-800">kräver åtgärd</span></p>
          <a href="/admin/assign" class="text-[10px] font-bold text-amber-800 underline hover:text-amber-950">Tilldela hästar &rarr;</a>
        <% } else { %>
          <p class="text-xl sm:text-2xl font-black text-emerald-700 mt-0.5">Alla klara</p>
          <p class="text-[10px] text-emerald-600 font-medium">Inga saknade hästar</p>
        <% } %>
      </div>
      <div class="w-9 h-9 rounded-xl <%= data.kpis.unassignedLessonsCount > 0 ? 'bg-amber-100 text-amber-700' : 'bg-emerald-50 text-emerald-600' %> flex items-center justify-center shrink-0">
        <i class="fa-solid <%= data.kpis.unassignedLessonsCount > 0 ? 'fa-triangle-exclamation' : 'fa-circle-check' %> text-sm"></i>
      </div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-stone-200 shadow-xs flex items-center justify-between">
      <div>
        <p class="text-[10px] sm:text-[11px] font-bold text-stone-400 uppercase tracking-wider">Arenor i drift</p>
        <p class="text-xl sm:text-2xl font-black text-stone-900 mt-0.5"><%= data.kpis.activeArenasCount %> <span class="text-xs font-normal text-stone-500">aktiva banor</span></p>
        <p class="text-[10px] text-stone-500">av <%= data.arenas.length %> anläggningar</p>
      </div>
      <div class="w-9 h-9 rounded-xl bg-sky-50 flex items-center justify-center text-sky-600 shrink-0">
        <i class="fa-solid fa-map-location-dot text-sm"></i>
      </div>
    </div>
  </div>

  <!-- VIEW 1: WEEKLY TIMETABLE GRID (Default) -->
  <% if (data.currentView === 'week') { %>
    <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
      <!-- Mobile Scroll Hint -->
      <div class="block sm:hidden px-4 py-2.5 bg-stone-50 border-b border-stone-200 text-[11px] text-stone-500 flex items-center justify-between">
        <span class="flex items-center gap-1.5"><i class="fa-solid fa-arrows-left-right text-stone-400"></i> Svep för att se hela veckan</span>
        <span class="text-[10px] font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded">V. <%= data.weekInfo.weekNumber %></span>
      </div>

      <div class="overflow-x-auto touch-scroll">
        <div class="min-w-[900px]">
          <!-- Days Header (8 Columns: Time + Mon-Sun) -->
          <div class="grid grid-cols-8 border-b border-stone-200 text-center text-xs font-bold text-stone-600 bg-stone-50/95">
            <div class="py-3 px-2 border-r border-stone-200 text-stone-400 sticky left-0 bg-stone-50 z-20 shadow-[1px_0_3px_rgba(0,0,0,0.06)] flex items-center justify-center">
              <i class="fa-regular fa-clock text-stone-500"></i>
            </div>
            <% data.days.forEach((day, index) => { %>
              <div class="py-3 px-2 border-r border-stone-200 transition <%= day.isToday ? 'bg-amber-50/60 text-amber-950 border-b-2 border-b-amber-500 font-extrabold' : '' %> <%= index === 6 ? 'border-r-0' : '' %>">
                <a href="<%= day.dayViewUrl %>" class="block group">
                  <div class="flex items-center justify-center gap-1">
                    <span class="text-[11px] uppercase tracking-wider <%= day.isToday ? 'text-amber-800' : 'text-stone-500' %>"><%= day.dayNameShort %></span>
                    <% if (day.isToday) { %>
                      <span class="text-[9px] font-bold uppercase px-1 py-0.2 rounded bg-amber-200 text-amber-900">Idag</span>
                    <% } %>
                  </div>
                  <span class="text-base sm:text-lg font-black block mt-0.5 group-hover:text-emerald-700 transition <%= day.isToday ? 'text-amber-950' : 'text-stone-900' %>">
                    <%= day.dayNumber %>
                  </span>
                  <% if (day.lessonCount > 0) { %>
                    <span class="inline-block text-[9px] font-medium text-stone-400 mt-0.5">
                      <%= day.lessonCount %> <%= day.lessonCount === 1 ? 'pass' : 'pass' %>
                    </span>
                  <% } else { %>
                    <span class="inline-block text-[9px] text-stone-300 mt-0.5">–</span>
                  <% } %>
                </a>
              </div>
            <% }) %>
          </div>

          <!-- Time Slots Grid -->
          <div class="divide-y divide-stone-100 text-xs">
            <% data.timetableGrid.forEach(row => { %>
              <div class="grid grid-cols-8 min-h-[4.75rem]">
                <!-- Time Column (Sticky) -->
                <div class="p-2 border-r border-stone-200 text-stone-400 font-mono text-center flex items-center justify-center sticky left-0 bg-white z-10 shadow-[1px_0_3px_rgba(0,0,0,0.06)] text-[11px]">
                  <%= row.time %>
                </div>

                <!-- 7 Day Columns -->
                <% data.days.forEach((day, dIndex) => { %>
                  <% const cellLessons = row.dayCells[day.dateStr] || []; %>
                  <div class="border-r border-stone-100 p-1.5 transition <%= day.isToday ? 'bg-amber-50/20' : '' %> <%= dIndex === 6 ? 'border-r-0' : '' %> flex flex-col gap-1.5 justify-start">
                    <% if (cellLessons.length > 0) { %>
                      <% cellLessons.forEach(lesson => { %>
                        <a href="<%= lesson.assignUrl %>" title="Klicka för att hantera hästtilldelning" class="block h-full rounded-lg p-2 text-[11px] shadow-xs border-l-4 transition hover:-translate-y-0.5 hover:shadow-md cursor-pointer <%= lesson.disciplineColor %>">
                          <div class="flex items-start justify-between gap-1">
                            <span class="font-bold block truncate leading-tight"><%= lesson.title %></span>
                            <span class="text-[9px] px-1.5 py-0.5 rounded font-semibold shrink-0 <%= lesson.allocationBadgeClass %>">
                              <%= lesson.allocationStatus %>
                            </span>
                          </div>

                          <div class="flex items-center gap-1 text-[10px] font-medium opacity-90 mt-1">
                            <i class="fa-regular fa-clock text-[9px]"></i>
                            <span><%= lesson.timeRange %></span>
                          </div>

                          <div class="flex items-center justify-between text-[9px] opacity-80 mt-1 pt-1 border-t border-black/5">
                            <span class="truncate" title="<%= lesson.arenaName %> &bull; <%= lesson.instructorName %>">
                              <i class="fa-solid fa-location-dot text-[8px] mr-0.5"></i><%= lesson.arenaName %>
                            </span>
                            <span class="shrink-0 font-medium ml-1">
                              <%= lesson.occupancyText %> el.
                            </span>
                          </div>
                        </a>
                      <% }) %>
                    <% } else { %>
                      <!-- Empty Slot Placeholder -->
                      <div class="h-full w-full rounded hover:bg-stone-50/70 transition flex items-center justify-center group">
                        <a href="/admin/lessons/create?date=<%= day.dateStr %>&startTime=<%= row.time %>" title="Skapa lektion på denna tid" class="opacity-0 group-hover:opacity-100 text-stone-300 hover:text-stone-600 transition text-[10px]">
                          <i class="fa-solid fa-plus"></i>
                        </a>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- VIEW 2: DETAILED DAY VIEW -->
  <% if (data.currentView === 'day') { %>
    <div class="space-y-6">
      <!-- Day Switcher Pills Bar -->
      <div class="bg-white rounded-2xl border border-stone-200 p-3 shadow-xs">
        <div class="flex items-center gap-2 overflow-x-auto pb-1">
          <% data.days.forEach(day => { %>
            <a href="<%= day.dayViewUrl %>" class="flex-1 min-w-[100px] text-center p-2.5 rounded-xl border transition <%= day.isSelected ? 'bg-[#1B3B2B] text-white border-emerald-900 shadow-sm font-bold' : (day.isToday ? 'bg-amber-50 text-amber-900 border-amber-300 font-semibold' : 'bg-stone-50 border-stone-200 text-stone-700 hover:bg-stone-100') %>">
              <div class="text-[10px] uppercase tracking-wider <%= day.isSelected ? 'text-emerald-200' : 'text-stone-400' %>">
                <%= day.dayNameShort %> <%= day.isToday ? '(Idag)' : '' %>
              </div>
              <div class="text-base font-black mt-0.5"><%= day.dayNumber %></div>
              <div class="text-[10px] mt-0.5 <%= day.isSelected ? 'text-emerald-100' : 'text-stone-500' %>">
                <%= day.lessonCount %> <%= day.lessonCount === 1 ? 'pass' : 'pass' %>
              </div>
            </a>
          <% }) %>
        </div>
      </div>

      <!-- Selected Day Details Container -->
      <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
        <div class="p-4 sm:p-6 border-b border-stone-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h3 class="text-lg font-bold text-stone-900"><%= data.selectedDayName %></h3>
            <p class="text-xs text-stone-500 mt-0.5"><%= data.selectedDayLessons.length %> lektionspass inbokade för denna dag.</p>
          </div>
          <a href="/admin/lessons/create?date=<%= data.selectedDate %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#3d2314] hover:bg-[#2c190e] text-white text-xs font-semibold rounded-xl shadow-xs transition">
            <i class="fa-solid fa-plus text-[10px]"></i>
            <span>Ny Lektion denna dag</span>
          </a>
        </div>

        <% if (data.selectedDayLessons.length === 0) { %>
          <!-- Empty State -->
          <div class="p-12 text-center space-y-4">
            <div class="w-16 h-16 rounded-full bg-stone-100 text-stone-400 flex items-center justify-center mx-auto text-2xl">
              <i class="fa-regular fa-calendar-xmark"></i>
            </div>
            <div>
              <h4 class="text-base font-bold text-stone-800">Inga lektioner schemalagda</h4>
              <p class="text-xs text-stone-500 max-w-md mx-auto mt-1">
                Det finns inga lektionspass inplanerade för <%= data.selectedDayName %>. Du kan lägga till en ny lektion direkt.
              </p>
            </div>
            <a href="/admin/lessons/create?date=<%= data.selectedDate %>" class="inline-flex items-center gap-2 bg-[#3d2314] hover:bg-[#2c190e] text-white px-4 py-2 rounded-xl text-xs font-semibold shadow-xs transition">
              <i class="fa-solid fa-plus text-xs"></i>
              <span>Skapa lektion för <%= data.selectedDayName %></span>
            </a>
          </div>
        <% } else { %>
          <!-- Detailed Lessons List for Day View -->
          <div class="divide-y divide-stone-100">
            <% data.selectedDayLessons.forEach(lesson => { %>
              <div class="p-4 sm:p-6 hover:bg-stone-50/60 transition space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                  <div class="flex items-start gap-3.5">
                    <!-- Time Badge -->
                    <div class="px-3 py-2 rounded-xl bg-stone-100 border border-stone-200 text-center shrink-0">
                      <span class="block text-base font-black text-stone-900 leading-none"><%= lesson.startTime %></span>
                      <span class="block text-[10px] text-stone-500 font-semibold mt-1 leading-none"><%= lesson.endTime %></span>
                    </div>

                    <!-- Title & Discipline Badges -->
                    <div>
                      <div class="flex flex-wrap items-center gap-2">
                        <h4 class="text-base font-bold text-stone-900"><%= lesson.title %></h4>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold <%= lesson.disciplineColor %>">
                          <%= lesson.lessonType %>
                        </span>
                        <span class="px-2 py-0.5 rounded-md text-xs font-medium bg-stone-100 text-stone-700">
                          <%= lesson.level %>
                        </span>
                        <% if (lesson.targetGroup) { %>
                          <span class="px-2 py-0.5 rounded-md text-[11px] text-stone-500 bg-stone-50 border border-stone-200">
                            <%= lesson.targetGroup %>
                          </span>
                        <% } %>
                      </div>

                      <div class="flex flex-wrap items-center gap-4 text-xs text-stone-500 mt-2">
                        <span class="flex items-center gap-1.5">
                          <i class="fa-solid fa-location-dot text-stone-400 text-[11px]"></i>
                          <strong><%= lesson.arenaName %></strong> (<%= lesson.arenaDimensions %>)
                        </span>
                        <span class="flex items-center gap-1.5">
                          <i class="fa-solid fa-graduation-cap text-stone-400 text-[11px]"></i>
                          Instruktör: <strong><%= lesson.instructorName %></strong>
                        </span>
                        <span class="flex items-center gap-1.5">
                          <i class="fa-solid fa-user-group text-stone-400 text-[11px]"></i>
                          Beläggning: <strong><%= lesson.occupancyText %> elever</strong>
                        </span>
                      </div>
                    </div>
                  </div>

                  <!-- Actions & Status Badges -->
                  <div class="flex items-center gap-2 self-start sm:self-center">
                    <span class="px-3 py-1.5 rounded-xl text-xs font-bold border <%= lesson.unassignedCount > 0 ? 'bg-amber-50 text-amber-800 border-amber-300' : 'bg-emerald-50 text-emerald-800 border-emerald-300' %>">
                      <i class="fa-solid <%= lesson.unassignedCount > 0 ? 'fa-triangle-exclamation mr-1' : 'fa-check mr-1' %>"></i>
                      <%= lesson.allocationStatus %>
                    </span>
                    <a href="<%= lesson.assignUrl %>" class="px-4 py-2 bg-[#1B3B2B] hover:bg-[#142e21] text-white text-xs font-semibold rounded-xl shadow-xs transition flex items-center gap-1.5">
                      <i class="fa-solid fa-horseshoe"></i>
                      <span>Tilldela hästar</span>
                    </a>
                    <a href="/admin/lessons/<%= lesson.id %>/edit" class="p-2 border border-stone-200 hover:bg-stone-100 text-stone-600 rounded-xl transition" title="Redigera lektion">
                      <i class="fa-solid fa-pen text-xs"></i>
                    </a>
                  </div>
                </div>

                <!-- Bookings & Horse Allocations Sub-panel -->
                <% if (lesson.bookings && lesson.bookings.length > 0) { %>
                  <div class="bg-stone-50/80 rounded-xl p-3 border border-stone-200/80 text-xs">
                    <p class="text-[11px] font-bold text-stone-500 uppercase tracking-wider mb-2">Inskrivna elever & hästfördelning</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
                      <% lesson.bookings.forEach(b => { %>
                        <div class="bg-white p-2.5 rounded-lg border <%= b.hasHorse ? 'border-stone-200' : 'border-amber-300 bg-amber-50/40' %> flex items-center justify-between">
                          <div>
                            <span class="font-bold text-stone-900 block"><%= b.studentName %></span>
                            <span class="text-[10px] text-stone-400 block"><%= b.studentWeight ? b.studentWeight + ' kg' : 'Vikt ej angiven' %></span>
                          </div>
                          <div class="text-right">
                            <% if (b.hasHorse) { %>
                              <span class="font-semibold text-emerald-800 block text-[11px]">
                                <i class="fa-solid fa-horseshoe text-[9px] mr-1"></i><%= b.horseName %>
                              </span>
                              <% if (b.weightWarning) { %>
                                <span class="text-[9px] font-bold text-amber-700 block">⚠️ Viktvarning</span>
                              <% } else { %>
                                <span class="text-[9px] text-emerald-600 block">✓ Godkänd</span>
                              <% } %>
                            <% } else { %>
                              <span class="text-[11px] font-bold text-amber-800 block">
                                <i class="fa-solid fa-triangle-exclamation mr-0.5"></i> Saknar häst
                              </span>
                              <a href="<%= lesson.assignUrl %>" class="text-[9px] text-amber-700 underline block font-semibold hover:text-amber-950">Välj häst</a>
                            <% } %>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
