<div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto space-y-6 sm:space-y-8">
  <!-- Top Greeting & Action Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight">
        God morgon, <%= currentUser ? currentUser.fullName.split(' ')[0] : 'Emma' %>
      </h2>
      <p class="text-xs sm:text-sm text-stone-500 mt-1">Här är en översikt över dagens verksamhet och lektioner.</p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin/lessons/create" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#3d2314] hover:bg-[#2c190e] text-white px-5 py-2.5 rounded-xl font-medium text-sm shadow-sm transition hover-lift">
        <i class="fa-solid fa-plus text-xs"></i>
        <span>Ny lektion</span>
      </a>
    </div>
  </div>

  <!-- Urgent Warning Banner if unassigned lessons -->
  <% if (data.urgentWarnings && data.urgentWarnings.length > 0) { %>
    <div class="p-4 bg-amber-50 border border-amber-200 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 shadow-sm">
      <div class="flex items-start sm:items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center flex-shrink-0 mt-0.5 sm:mt-0">
          <i class="fa-solid fa-triangle-exclamation text-lg"></i>
        </div>
        <div>
          <h3 class="text-sm font-bold text-amber-900">Oklara hästtilldelningar (<%= data.urgentWarnings.length %> pass behöver åtgärd)</h3>
          <p class="text-xs text-amber-700 mt-0.5">Elever saknar tilldelad häst inför dagens pass. Kontrollera bärighet och tilldela hästar.</p>
        </div>
      </div>
      <a href="/admin/assign" class="self-start sm:self-center shrink-0 px-4 py-2 bg-amber-700 hover:bg-amber-800 text-white text-xs font-semibold rounded-xl transition shadow-sm">
        Åtgärda nu &rarr;
      </a>
    </div>
  <% } %>

  <!-- Top 3 KPI Cards (Matching PDF 3 page 13) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
    <!-- Card 1: Dagens lektioner -->
    <div class="bg-white p-5 sm:p-6 rounded-2xl border border-stone-200/80 shadow-sm flex items-center justify-between hover-lift">
      <div>
        <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Dagens lektioner</p>
        <p class="text-3xl sm:text-4xl font-extrabold text-stone-900 mt-2"><%= data.kpis.totalLessonsToday %></p>
        <p class="text-xs text-stone-500 mt-1">Schemalagda ridpass idag</p>
      </div>
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl sm:text-2xl border border-emerald-100 shrink-0">
        <i class="fa-solid fa-book-open"></i>
      </div>
    </div>

    <!-- Card 2: Aktiva elever -->
    <div class="bg-white p-5 sm:p-6 rounded-2xl border border-stone-200/80 shadow-sm flex items-center justify-between hover-lift">
      <div>
        <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Aktiva elever</p>
        <p class="text-3xl sm:text-4xl font-extrabold text-stone-900 mt-2"><%= data.kpis.activeStudents %></p>
        <p class="text-xs text-stone-500 mt-1">Inskrivna i ridgrupper</p>
      </div>
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-sky-50 text-sky-700 flex items-center justify-center text-xl sm:text-2xl border border-sky-100 shrink-0">
        <i class="fa-solid fa-user-group"></i>
      </div>
    </div>

    <!-- Card 3: Hästar i verksamheten -->
    <div class="bg-white p-5 sm:p-6 rounded-2xl border border-stone-200/80 shadow-sm flex items-center justify-between hover-lift sm:col-span-2 lg:col-span-1">
      <div>
        <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Hästar i verksamheten</p>
        <p class="text-3xl sm:text-4xl font-extrabold text-stone-900 mt-2"><%= data.kpis.totalHorsesInOperation %></p>
        <p class="text-xs text-emerald-600 font-medium mt-1"><%= data.kpis.availableNow %> lediga | <%= data.kpis.needsRest %> i vila</p>
      </div>
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-amber-50 text-amber-800 flex items-center justify-center text-xl sm:text-2xl border border-amber-100 shrink-0">
        <i class="fa-solid fa-horseshoe"></i>
      </div>
    </div>
  </div>

  <!-- Dagens Schema Table Section (Matching PDF 3 page 13) -->
  <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="p-4 sm:p-6 border-b border-stone-100 flex items-center justify-between">
      <div>
        <h3 class="text-base sm:text-lg font-bold text-stone-900 tracking-tight">DAGENS SCHEMA</h3>
        <p class="text-xs text-stone-500 mt-0.5">Dagens lektioner och aktuell status för hästtilldelning</p>
      </div>
      <a href="/admin/schedule" class="text-xs font-semibold text-emerald-700 hover:text-emerald-900 flex items-center gap-1 shrink-0">
        <span>Se veckoschema</span>
        <i class="fa-solid fa-chevron-right text-[10px]"></i>
      </a>
    </div>

    <!-- Mobile Scroll Hint -->
    <div class="block sm:hidden px-4 py-2 bg-stone-50 border-b border-stone-100 text-[11px] text-stone-500 flex items-center gap-1.5">
      <i class="fa-solid fa-arrows-left-right text-stone-400"></i>
      <span>Svep i sidled för att se alla lektionsdetaljer</span>
    </div>

    <div class="overflow-x-auto touch-scroll">
      <table class="w-full text-left border-collapse text-sm min-w-[720px]">
        <thead>
          <tr class="bg-stone-50 text-stone-500 text-xs font-bold uppercase tracking-wider border-b border-stone-200">
            <th class="py-3.5 px-4 sm:px-6">Tid</th>
            <th class="py-3.5 px-4 sm:px-6">Lektionstyp</th>
            <th class="py-3.5 px-4 sm:px-6">Instruktör</th>
            <th class="py-3.5 px-4 sm:px-6">Elever</th>
            <th class="py-3.5 px-4 sm:px-6">Hästar</th>
            <th class="py-3.5 px-4 sm:px-6">Ridhus / Bana</th>
            <th class="py-3.5 px-4 sm:px-6 text-right">Åtgärd</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if (data.lessons && data.lessons.length > 0) { %>
            <% data.lessons.forEach(lesson => { %>
              <tr class="hover:bg-stone-50/80 transition">
                <!-- Tid -->
                <td class="py-4 px-4 sm:px-6 font-semibold text-stone-900 whitespace-nowrap">
                  <%= lesson.timeRange %>
                </td>

                <!-- Lektionstyp & Nivå -->
                <td class="py-4 px-4 sm:px-6 whitespace-nowrap">
                  <div class="font-semibold text-stone-900"><%= lesson.title %></div>
                  <div class="text-xs text-stone-500"><%= lesson.level %></div>
                </td>

                <!-- Instruktör -->
                <td class="py-4 px-4 sm:px-6 text-stone-700 whitespace-nowrap">
                  <%= lesson.instructorName %>
                </td>

                <!-- Elever (Beläggning) -->
                <td class="py-4 px-4 sm:px-6 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= lesson.isFull ? 'bg-amber-50 text-amber-800' : 'bg-stone-100 text-stone-700' %>">
                    <%= lesson.occupancyText %>
                  </span>
                </td>

                <!-- Hästar Tilldelning Status -->
                <td class="py-4 px-4 sm:px-6 whitespace-nowrap">
                  <% if (lesson.unassignedCount > 0) { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                      <i class="fa-solid fa-triangle-exclamation text-[11px]"></i>
                      <span><%= lesson.allocationStatus %></span>
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                      <i class="fa-solid fa-circle-check text-[11px]"></i>
                      <span>Klar</span>
                    </span>
                  <% } %>
                </td>

                <!-- Arena -->
                <td class="py-4 px-4 sm:px-6 text-stone-600 whitespace-nowrap">
                  <%= lesson.arenaName %>
                </td>

                <!-- Åtgärd -->
                <td class="py-4 px-4 sm:px-6 text-right whitespace-nowrap">
                  <a href="/admin/assign/<%= lesson.id %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#4a2828] hover:bg-[#381e1e] text-white text-xs font-medium rounded-lg transition shadow-sm">
                    <span>Tilldela</span>
                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="py-12 text-center text-stone-400">
                <i class="fa-solid fa-calendar-xmark text-3xl mb-2 text-stone-300 block"></i>
                Inga lektioner inbokade för idag.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
