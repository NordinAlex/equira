<div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto space-y-8">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-800 text-white flex items-center justify-center shadow-xs">
          <i class="fa-solid fa-clock-rotate-left text-lg"></i>
        </div>
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight">Stämpling & Tidsredovisning</h1>
          <p class="text-sm text-stone-500 mt-0.5">Hantera personalens instämplingar, arbetade timmar och tidsjusteringar</p>
        </div>
      </div>
    </div>
    
    <div class="flex items-center gap-2.5">      
      <button type="button" 
              onclick="openManualPunchModal()"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-800 hover:bg-emerald-900 text-white text-xs font-bold transition shadow-xs cursor-pointer">
        <i class="fa-solid fa-plus"></i>
        <span>Manuell Stämpling</span>
      </button>
    </div>
  </div>

  <!-- KPI Overview Stat Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Active on site -->
    <div class="bg-white rounded-2xl p-5 border border-stone-200/80 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold tracking-wider uppercase text-stone-400">PÅ PLATS JUST NU</p>
        <p class="text-3xl font-black text-stone-900 mt-1 flex items-center gap-2">
          <%= stats.activeCount %>
          <% if (stats.activeCount > 0) { %>
            <span class="inline-flex w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <% } %>
        </p>
        <p class="text-xs text-stone-500 mt-1 font-medium">Instämplad personal</p>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl">
        <i class="fa-solid fa-user-check"></i>
      </div>
    </div>

    <!-- Total hours today -->
    <div class="bg-white rounded-2xl p-5 border border-stone-200/80 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold tracking-wider uppercase text-stone-400">ARBETAD TID IDAG</p>
        <p class="text-3xl font-black text-stone-900 mt-1"><%= stats.totalHoursTodayStr %></p>
        <p class="text-xs text-stone-500 mt-1 font-medium">Totalt loggade timmar</p>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center text-xl">
        <i class="fa-solid fa-hourglass-half"></i>
      </div>
    </div>

    <!-- Planned shifts -->
    <div class="bg-white rounded-2xl p-5 border border-stone-200/80 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold tracking-wider uppercase text-stone-400">PLANERADE PASS IDAG</p>
        <p class="text-3xl font-black text-stone-900 mt-1"><%= stats.plannedShiftsCount %></p>
        <p class="text-xs text-stone-500 mt-1 font-medium"><%= stats.completedShiftsCount %> pass avslutade</p>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center text-xl">
        <i class="fa-regular fa-calendar-days"></i>
      </div>
    </div>

    <!-- Overtime / Variance -->
    <div class="bg-white rounded-2xl p-5 border border-stone-200/80 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold tracking-wider uppercase text-stone-400">AVVIKELSER / ÖVERTID</p>
        <p class="text-3xl font-black text-stone-900 mt-1"><%= stats.overtimeCount %></p>
        <p class="text-xs text-purple-700 font-bold mt-1 flex items-center gap-1">
          <i class="fa-solid fa-clock"></i> <%= stats.totalOvertimeStr || '0h 00m' %> övertid loggad
        </p>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-700 flex items-center justify-center text-xl">
        <i class="fa-solid fa-chart-line"></i>
      </div>
    </div>
  </div>

  <!-- Live Active Staff on Site -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-emerald-500 <%= activeStaff.length > 0 ? 'animate-pulse' : '' %>"></span>
        <h2 class="text-lg font-bold text-stone-900">Just nu i tjänst på anläggningen (<%= activeStaff.length %>)</h2>
      </div>
      <span class="text-xs text-stone-500">Uppdateras i realtid</span>
    </div>

    <% if (activeStaff && activeStaff.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% activeStaff.forEach(staff => { %>
          <div class="bg-white rounded-2xl p-5 border border-emerald-200/80 shadow-2xs relative flex flex-col justify-between hover:shadow-xs transition">
            <div class="space-y-3">
              <div class="flex items-start justify-between">
                <div class="flex items-center gap-3">
                  <img src="<%= staff.avatarUrl %>" alt="<%= staff.fullName %>" class="w-12 h-12 rounded-full object-cover border-2 border-emerald-100">
                  <div>
                    <h3 class="font-bold text-stone-900 text-sm"><%= staff.fullName %></h3>
                    <p class="text-xs text-stone-400"><%= staff.title %></p>
                  </div>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800">
                  <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
                  Aktiv
                </span>
              </div>

              <div class="bg-stone-50 rounded-xl p-3 space-y-1.5 text-xs">
                <div class="flex justify-between">
                  <span class="text-stone-500">Instämplad:</span>
                  <span class="font-bold text-stone-800">Kl <%= staff.checkInTimeStr %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-stone-500">Planerat pass:</span>
                  <span class="font-semibold text-stone-700"><%= staff.plannedPassStr %></span>
                </div>
                <div class="flex justify-between pt-1 border-t border-stone-200/60">
                  <span class="text-stone-500">Pågående arbetstid:</span>
                  <span class="font-black text-emerald-800"><%= staff.elapsedStr %></span>
                </div>
              </div>

              <% if (staff.subtextNote) { %>
                <p class="text-[11px] text-stone-500 italic"><i class="fa-regular fa-comment-dots mr-1"></i><%= staff.subtextNote %></p>
              <% } %>
            </div>

            <!-- Direct Clock Out Action Button -->
            <div class="pt-4 mt-3 border-t border-stone-100 flex items-center justify-between">
              <span class="text-[11px] text-stone-400">ID #<%= staff.id %></span>
              <button type="button" 
                      onclick="openQuickClockOutModal('<%= staff.id %>', '<%= staff.fullName %>')"
                      class="px-3 py-1.5 rounded-xl bg-stone-900 hover:bg-stone-800 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer">
                <i class="fa-solid fa-right-from-bracket text-[11px]"></i>
                <span>Stämpla ut personal</span>
              </button>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-2xl p-8 border border-stone-200 text-center space-y-2">
        <div class="w-12 h-12 rounded-2xl bg-stone-100 text-stone-400 flex items-center justify-center mx-auto text-xl">
          <i class="fa-solid fa-mug-hot"></i>
        </div>
        <p class="font-bold text-stone-800 text-sm">Ingen personal är instämplad just nu</p>
        <p class="text-xs text-stone-400 max-w-sm mx-auto">Personal stämplar in från sin mobila sida, eller så kan administratör stämpla in personal manuellt med knappen ovan.</p>
      </div>
    <% } %>
  </div>

  <!-- Filter & History Table -->
  <div class="bg-white rounded-2xl border border-stone-200/80 shadow-2xs overflow-hidden">
    
    <!-- Filter Bar Header -->
    <div class="p-5 border-b border-stone-100 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <h2 class="text-lg font-bold text-stone-900">Tidshistorik & Stämpelloggar</h2>
        <span class="text-xs text-stone-400 font-medium">Visar <%= entries.length %> stämplingar</span>
      </div>

      <!-- Filters Form -->
      <form method="GET" action="/admin/stampling" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- Date filter -->
        <div>
          <label class="block text-[11px] font-bold text-stone-500 uppercase tracking-wider mb-1">Datum</label>
          <select name="date" class="w-full text-xs bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-emerald-700">
            <option value="all" <%= (query.date === 'all' || !query.date) ? 'selected' : '' %>>Alla datum</option>
            <option value="today" <%= query.date === 'today' ? 'selected' : '' %>>Idag</option>
            <option value="yesterday" <%= query.date === 'yesterday' ? 'selected' : '' %>>Igår</option>
          </select>
        </div>

        <!-- Staff member filter -->
        <div>
          <label class="block text-[11px] font-bold text-stone-500 uppercase tracking-wider mb-1">Personal</label>
          <select name="userId" class="w-full text-xs bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-emerald-700">
            <option value="all" <%= (!query.userId || query.userId === 'all') ? 'selected' : '' %>>Alla personal</option>
            <% staffMembers.forEach(user => { %>
              <option value="<%= user.id %>" <%= query.userId == user.id ? 'selected' : '' %>><%= user.fullName %></option>
            <% }) %>
          </select>
        </div>

        <!-- Status filter -->
        <div>
          <label class="block text-[11px] font-bold text-stone-500 uppercase tracking-wider mb-1">Status</label>
          <select name="status" class="w-full text-xs bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-emerald-700">
            <option value="all" <%= (!query.status || query.status === 'all') ? 'selected' : '' %>>Alla statusar</option>
            <option value="INSTAMPLAD" <%= query.status === 'INSTAMPLAD' ? 'selected' : '' %>>Instämplad (Pågående)</option>
            <option value="AVSLUTAD" <%= query.status === 'AVSLUTAD' ? 'selected' : '' %>>Avslutad</option>
            <option value="JUSTERAD" <%= query.status === 'JUSTERAD' ? 'selected' : '' %>>Justerad</option>
          </select>
        </div>

        <!-- Submit & Reset -->
        <div class="flex items-end gap-2">
          <button type="submit" class="flex-1 bg-stone-900 hover:bg-stone-800 text-white text-xs font-bold py-2 px-3 rounded-xl transition cursor-pointer">
            <i class="fa-solid fa-filter mr-1"></i>Filtrera
          </button>
          <a href="/admin/stampling" class="bg-stone-100 hover:bg-stone-200 text-stone-600 text-xs font-bold py-2 px-3 rounded-xl transition text-center">
            Rensa
          </a>
        </div>
      </form>
    </div>

    <!-- Data Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-stone-50/80 text-stone-500 font-bold border-b border-stone-200/80 uppercase tracking-wider text-[10px]">
            <th class="py-3 px-4">Personal</th>
            <th class="py-3 px-4">Datum</th>
            <th class="py-3 px-4">Planerat pass</th>
            <th class="py-3 px-4">Incheckad</th>
            <th class="py-3 px-4">Utcheckad</th>
            <th class="py-3 px-4">Arbetad tid</th>
            <th class="py-3 px-4">Avvikelse</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4">Notering</th>
            <th class="py-3 px-4 text-right">Åtgärder</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if (entries && entries.length > 0) { %>
            <% entries.forEach(entry => { %>
              <tr class="hover:bg-stone-50/70 transition">
                <!-- Personal -->
                <td class="py-3 px-4">
                  <div class="flex items-center gap-2.5">
                    <img src="<%= entry.avatarUrl %>" alt="<%= entry.fullName %>" class="w-8 h-8 rounded-full object-cover border border-stone-200">
                    <div>
                      <p class="font-bold text-stone-900 text-xs"><%= entry.fullName %></p>
                      <p class="text-[10px] text-stone-400"><%= entry.title %></p>
                    </div>
                  </div>
                </td>

                <!-- Datum -->
                <td class="py-3 px-4 font-medium text-stone-700 whitespace-nowrap">
                  <%= entry.date %>
                </td>

                <!-- Planerat pass -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <span class="font-medium text-stone-700 block"><%= entry.plannedPassStr %></span>
                  <% if (entry.hasPlannedAdjusted) { %>
                    <span class="text-[10px] text-stone-400 block line-through">Orig: <%= entry.originalPlannedPassStr %></span>
                  <% } %>
                </td>

                <!-- Incheckad -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <% if (entry.hasInAdjusted) { %>
                    <span class="text-[10px] text-stone-400 block line-through">Orig: <%= entry.originalCheckInTimeStr %></span>
                    <span class="font-bold text-amber-900 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200">
                      <%= entry.checkInTimeStr %>
                    </span>
                  <% } else { %>
                    <span class="font-bold text-stone-900 bg-stone-100 px-2 py-0.5 rounded-md">
                      <%= entry.checkInTimeStr %>
                    </span>
                  <% } %>
                </td>

                <!-- Utcheckad -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <% if (entry.status === 'INSTAMPLAD') { %>
                    <span class="text-emerald-700 font-bold flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
                      Pågår...
                    </span>
                  <% } else if (entry.hasOutAdjusted) { %>
                    <span class="text-[10px] text-stone-400 block line-through">Orig: <%= entry.originalCheckOutTimeStr %></span>
                    <span class="font-bold text-amber-900 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200">
                      <%= entry.checkOutTimeStr %>
                    </span>
                  <% } else { %>
                    <span class="font-medium text-stone-800">
                      <%= entry.checkOutTimeStr %>
                    </span>
                  <% } %>
                </td>

                <!-- Arbetad tid -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <span class="font-black text-stone-900 block text-xs"><%= entry.netWorkedStr || entry.durationStr %></span>
                  <% if (entry.breakMinutes > 0) { %>
                    <span class="text-[9.5px] text-stone-400 block font-medium" title="Bruttotid på plats: <%= entry.durationStr %>, Rastavdrag: <%= entry.breakStr %>">
                      Rast: <%= entry.breakStr %>
                    </span>
                  <% } %>
                </td>

                <!-- Avvikelse / Övertid -->
                <td class="py-3 px-4 whitespace-nowrap font-bold">
                  <% if (entry.isOvertime || entry.diffType === 'positive') { %>
                    <span class="inline-flex items-center gap-1 text-purple-900 bg-purple-100/90 px-2.5 py-1 rounded-lg text-xs font-black border border-purple-300 shadow-2xs" title="Automatisk övertid: <%= entry.overtimeStr || entry.diffFormatted %>">
                      <i class="fa-solid fa-fire-flame-curved text-purple-600 text-[10px]"></i>
                      +<%= entry.overtimeStr || entry.diffFormatted %>
                    </span>
                  <% } else if (entry.diffType === 'negative') { %>
                    <span class="inline-flex items-center gap-1 text-rose-700 bg-rose-50 px-2 py-0.5 rounded-md text-[11px] font-bold border border-rose-200" title="Underskriden tid: <%= entry.diffFormatted %>">
                      <i class="fa-solid fa-arrow-down text-rose-500 text-[9px]"></i>
                      <%= entry.diffFormatted %>
                    </span>
                  <% } else { %>
                    <span class="text-stone-400 text-xs font-medium">0 min</span>
                  <% } %>
                </td>

                <!-- Status -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <% if (entry.isAdjusted) { %>
                    <div class="space-y-0.5">
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-300">
                        <i class="fa-solid fa-pen-nib text-[9px]"></i> Justerad
                      </span>
                      <% if (entry.adjustedBy) { %>
                        <span class="text-[9px] text-stone-400 block">av <%= entry.adjustedBy %></span>
                      <% } %>
                    </div>
                  <% } else { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold border <%= entry.statusBadgeClass %>">
                      <%= entry.statusLabel %>
                    </span>
                  <% } %>
                </td>

                <!-- Notering -->
                <td class="py-3 px-4 max-w-xs text-stone-600">
                  <% if (entry.isAdjusted && (entry.hasInAdjusted || entry.hasOutAdjusted)) { %>
                    <span class="text-amber-800 text-[10px] font-semibold block">
                      <i class="fa-solid fa-clock-rotate-left mr-1"></i>Orig stämplat: <%= entry.originalCheckInTimeStr || '–' %> – <%= entry.originalCheckOutTimeStr || '–' %>
                    </span>
                  <% } %>
                  <span class="truncate block text-stone-500" title="<%= entry.subtextNote || entry.adminNote %>">
                    <%= entry.subtextNote || entry.adminNote || '–' %>
                  </span>
                </td>

                <!-- Åtgärder -->
                <td class="py-3 px-4 text-right whitespace-nowrap">
                  <div class="flex items-center justify-end gap-1.5">
                    <% if (entry.status === 'INSTAMPLAD') { %>
                      <button type="button" 
                              onclick="openQuickClockOutModal('<%= entry.id %>', '<%= entry.fullName %>')"
                              title="Stämpla ut"
                              class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-800 hover:bg-emerald-100 flex items-center justify-center transition cursor-pointer">
                        <i class="fa-solid fa-right-from-bracket text-xs"></i>
                      </button>
                    <% } %>

                    <!-- Redigera knapp -->
                    <button type="button"
                            data-entry="<%= JSON.stringify(entry) %>"
                            onclick="openEditPunchModal(JSON.parse(this.dataset.entry))"
                            title="Redigera tidsstämpel"
                            class="w-7 h-7 rounded-lg bg-stone-100 text-stone-700 hover:bg-stone-200 flex items-center justify-center transition cursor-pointer">
                      <i class="fa-solid fa-pen-to-square text-xs"></i>
                    </button>

                    <!-- Ta bort knapp -->
                    <button type="button" 
                            data-id="<%= entry.id %>"
                            data-details="<%= entry.fullName %> (<%= entry.date %>)"
                            onclick="openConfirmDeletePunchModal(this.dataset.id, this.dataset.details)"
                            title="Ta bort tidsstämpel"
                            class="w-7 h-7 rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 flex items-center justify-center transition cursor-pointer">
                      <i class="fa-regular fa-trash-can text-xs"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="10" class="py-8 text-center text-stone-400">
                <i class="fa-regular fa-calendar-xmark text-2xl mb-1 block"></i>
                Inga tidsstämplingar matchar det valda filtret.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>

</div>

<!-- Modal 1: Manuell Stämpling (Lägg till tidsregistrering) -->
<div id="manualPunchModal" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-xl space-y-5 animate-scale-in">
    <div class="flex items-center justify-between border-b border-stone-100 pb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center">
          <i class="fa-solid fa-clock-rotate-left text-sm"></i>
        </div>
        <h3 class="font-extrabold text-stone-900 text-lg">Manuell Stämpling / Ny tidsregistrering</h3>
      </div>
      <button type="button" onclick="closeManualPunchModal()" class="text-stone-400 hover:text-stone-600 text-lg p-1">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form action="/admin/stampling/in" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-stone-700 mb-1">Personal *</label>
        <select name="userId" required class="w-full text-sm bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-emerald-700">
          <% staffMembers.forEach(user => { %>
            <option value="<%= user.id %>"><%= user.fullName %> (<%= user.title %>)</option>
          <% }) %>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-stone-700 mb-1">Datum *</label>
          <input type="date" name="date" id="manualDate" required class="w-full text-sm bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 font-medium">
        </div>
        <div>
          <label class="block text-xs font-bold text-stone-700 mb-1">Status</label>
          <select name="status" class="w-full text-sm bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 font-medium">
            <option value="INSTAMPLAD">Instämplad (Aktiv på plats)</option>
            <option value="AVSLUTAD" selected>Avslutad pass</option>
            <option value="JUSTERAD">Justerad</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-stone-700 mb-1">Instämplad (Tid) *</label>
          <input type="time" name="checkInTime" value="07:00" required class="w-full text-sm bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 font-medium">
        </div>
        <div>
          <label class="block text-xs font-bold text-stone-700 mb-1">Utstämplad (Tid)</label>
          <input type="time" name="checkOutTime" value="16:00" class="w-full text-sm bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 font-medium">
          <span class="text-[10px] text-stone-400">Lämna tomt om passet fortfarande pågår</span>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-stone-700 mb-1">Planerad Start</label>
          <input type="time" name="plannedStartTime" value="07:00" class="w-full text-sm bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 font-medium">
        </div>
        <div>
          <label class="block text-xs font-bold text-stone-700 mb-1">Planerad Slut</label>
          <input type="time" name="plannedEndTime" value="16:00" class="w-full text-sm bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 font-medium">
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-stone-700 mb-1">Notering / Kommentar</label>
