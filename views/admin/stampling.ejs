<script>
  let currentEditingEntry = null;

  // Manual Punch Modal
  function openManualPunchModal() {
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('manualDate').value = today;
    document.getElementById('manualPunchModal').classList.remove('hidden');
  }
  function closeManualPunchModal() {
    document.getElementById('manualPunchModal').classList.add('hidden');
  }

  // Edit Punch Modal
  function openEditPunchModal(entry) {
    currentEditingEntry = entry;
    const form = document.getElementById('editPunchForm');
    form.action = '/admin/stampling/edit/' + entry.id;

    document.getElementById('editStaffName').value = entry.fullName + ' (' + entry.title + ')';
    document.getElementById('editDate').value = entry.date;
    document.getElementById('editStatus').value = entry.status;
    document.getElementById('editCheckIn').value = entry.checkInTimeStr !== '–' ? entry.checkInTimeStr : '';
    document.getElementById('editCheckOut').value = (entry.checkOutTimeStr !== 'Pågående...' && entry.checkOutTimeStr !== '–') ? entry.checkOutTimeStr : '';
    document.getElementById('editPlannedStart').value = entry.plannedStartTime || '07:00';
    document.getElementById('editPlannedEnd').value = entry.plannedEndTime || '16:00';
    document.getElementById('editSubtextNote').value = entry.subtextNote || '';
    document.getElementById('editAdminNote').value = entry.adminNote || '';

    // Original Stamping Info
    const origIn = entry.originalCheckInTimeStr || entry.checkInTimeStr || '–';
    const origOut = (entry.originalCheckOutTimeStr && entry.originalCheckOutTimeStr !== '–') ? entry.originalCheckOutTimeStr : (entry.checkOutTimeStr !== 'Pågående...' ? entry.checkOutTimeStr : '–');
    const origPlanned = entry.originalPlannedPassStr || entry.plannedPassStr || '–';

    document.getElementById('modalOrigCheckIn').textContent = origIn;
    document.getElementById('modalOrigCheckOut').textContent = origOut;
    document.getElementById('modalOrigPlanned').textContent = origPlanned;

    const badge = document.getElementById('modalAdjustedBadge');
    const adjustedText = document.getElementById('modalAdjustedByText');
    if (entry.isAdjusted) {
      badge.classList.remove('hidden');
      adjustedText.textContent = `Senast ändrad av ${entry.adjustedBy || 'Admin'}${entry.adjustedAtStr ? ' kl ' + entry.adjustedAtStr : ''}`;
    } else {
      badge.classList.add('hidden');
      adjustedText.textContent = 'Orörd originalstämpling från personal';
    }

    document.getElementById('editPunchModal').classList.remove('hidden');
    updateModalLiveCalc();
  }

  // Helper to parse time string "HH:MM" to minutes
  function timeStringToMinutes(str) {
    if (!str || typeof str !== 'string' || !str.includes(':')) return null;
    const parts = str.split(':').map(Number);
    if (isNaN(parts[0]) || isNaN(parts[1])) return null;
    return parts[0] * 60 + parts[1];
  }

  // Format minutes into clean duration string (e.g. "8h 15m" or "45m" or "0h 00m")
  function formatMinutesShort(totalMins) {
    if (totalMins === null || totalMins === undefined || isNaN(totalMins) || totalMins < 0) return '0h 00m';
    const h = Math.floor(totalMins / 60);
    const m = Math.floor(totalMins % 60);
    return `${h}h ${String(m).padStart(2, '0')}m`;
  }

  // Live Automatic Overtime & Time Calculation in Edit Modal
  function updateModalLiveCalc() {
    const inVal = document.getElementById('editCheckIn').value;
    const outVal = document.getElementById('editCheckOut').value;
    const pStartVal = document.getElementById('editPlannedStart').value;
    const pEndVal = document.getElementById('editPlannedEnd').value;

    const inMin = timeStringToMinutes(inVal);
    let outMin = timeStringToMinutes(outVal);

    let grossMins = 0;
    let breakMins = 0;
    let netMins = 0;

    if (inMin !== null && outMin !== null) {
      if (outMin < inMin) outMin += 24 * 60; // handles overnight shift
      grossMins = Math.max(0, outMin - inMin);

      // Swedish standard break deduction rules
      if (grossMins >= 630) { // >= 10.5h -> 90 min rast
        breakMins = 90;
      } else if (grossMins >= 450) { // >= 7.5h -> 60 min rast
        breakMins = 60;
      } else if (grossMins >= 300) { // >= 5h -> 30 min rast
        breakMins = 30;
      } else {
        breakMins = 0;
      }

      netMins = Math.max(0, grossMins - breakMins);
    }

    // Planned net minutes
    const pStartMin = timeStringToMinutes(pStartVal);
    let pEndMin = timeStringToMinutes(pEndVal);
    let plannedGross = 0;
    let plannedBreak = 0;
    let plannedNet = 480; // default 8 hours

    if (pStartMin !== null && pEndMin !== null) {
      if (pEndMin < pStartMin) pEndMin += 24 * 60;
      plannedGross = Math.max(0, pEndMin - pStartMin);
      if (plannedGross >= 630) plannedBreak = 90;
      else if (plannedGross >= 450) plannedBreak = 60;
      else if (plannedGross >= 300) plannedBreak = 30;
      else plannedBreak = 0;

      plannedNet = Math.max(0, plannedGross - plannedBreak);
    }

    // Diff / Overtime
    const diff = (inMin !== null && outMin !== null) ? (netMins - plannedNet) : 0;
    const overtimeMins = diff > 0 ? diff : 0;

    // Update hidden field
    const editOvertimeInput = document.getElementById('editOvertimeMinutes');
    if (editOvertimeInput) {
      editOvertimeInput.value = overtimeMins;
    }

    // Update displays
    const grossEl = document.getElementById('modalLiveGrossTime');
    const breakEl = document.getElementById('modalLiveBreak');
    const netEl = document.getElementById('modalLiveNetTime');
    const plannedEl = document.getElementById('modalLivePlannedTime');
    const diffBadge = document.getElementById('modalLiveDiffBadge');
    const breakHint = document.getElementById('modalLiveBreakHint');

    if (grossEl) grossEl.textContent = (inMin !== null && outMin !== null) ? formatMinutesShort(grossMins) : '--:--';
    if (breakEl) breakEl.textContent = (inMin !== null && outMin !== null) ? `${breakMins} min` : '--:--';
    if (netEl) netEl.textContent = (inMin !== null && outMin !== null) ? formatMinutesShort(netMins) : '--:--';
    if (plannedEl) plannedEl.textContent = formatMinutesShort(plannedNet);

    if (breakHint) {
      if (breakMins > 0) {
        breakHint.innerHTML = `<i class="fa-solid fa-mug-hot text-amber-600 mr-1"></i>Kollektivavtal: ${breakMins} min rast avdragen från bruttotid`;
      } else {
        breakHint.innerHTML = `<i class="fa-solid fa-mug-hot text-stone-400 mr-1"></i>Ingen rast (<5 tim sammanhängande pass)`;
      }
    }

    if (diffBadge) {
      if (inMin === null || outMin === null) {
        diffBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-stone-100 text-stone-500 border border-stone-200';
        diffBadge.innerHTML = '<i class="fa-regular fa-clock mr-1"></i>Ej avslutad';
      } else if (diff > 0) {
        const hrs = Math.floor(diff / 60);
        const mins = diff % 60;
        const diffText = hrs > 0 ? `+${hrs}h ${mins > 0 ? mins + 'm' : ''} Övertid` : `+${mins} min Övertid`;
        diffBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-black bg-purple-100 text-purple-900 border border-purple-300 animate-pulse';
        diffBadge.innerHTML = `<i class="fa-solid fa-arrow-trend-up mr-1 text-purple-700"></i>${diffText}`;
      } else if (diff < 0) {
        const absDiff = Math.abs(diff);
        const hrs = Math.floor(absDiff / 60);
        const mins = absDiff % 60;
        const diffText = hrs > 0 ? `-${hrs}h ${mins > 0 ? mins + 'm' : ''} Undertid` : `-${mins} min Undertid`;
        diffBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200';
        diffBadge.innerHTML = `<i class="fa-solid fa-arrow-trend-down mr-1 text-rose-600"></i>${diffText}`;
      } else {
        diffBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200';
        diffBadge.innerHTML = '<i class="fa-solid fa-check mr-1 text-emerald-600"></i>Enligt schema (0 min)';
      }
    }
  }

  // Admin Quick Action: Align to planned times
  function alignToPlannedTimes() {
    const pStart = document.getElementById('editPlannedStart').value;
    const pEnd = document.getElementById('editPlannedEnd').value;
    if (pStart) document.getElementById('editCheckIn').value = pStart;
    if (pEnd) document.getElementById('editCheckOut').value = pEnd;
    updateModalLiveCalc();
    appendReasonTag('Jämkad enligt schema (0 övertid)');
  }

  // Admin Quick Action: Set from staff's original punch
  function setFromStaffPunch() {
    if (!currentEditingEntry) return;
    const origIn = currentEditingEntry.originalCheckInTimeStr || currentEditingEntry.checkInTimeStr;
    const origOut = currentEditingEntry.originalCheckOutTimeStr || currentEditingEntry.checkOutTimeStr;
    if (origIn && origIn !== '–') document.getElementById('editCheckIn').value = origIn;
    if (origOut && origOut !== '–' && origOut !== 'Pågående...') document.getElementById('editCheckOut').value = origOut;
    updateModalLiveCalc();
    appendReasonTag('Korrigerad stämpling (personalens stämpel)');
  }

  // Admin Quick Action: Approve overtime in note
  function approveOvertimeInNote() {
    const overtimeMins = parseInt(document.getElementById('editOvertimeMinutes').value, 10) || 0;
    if (overtimeMins > 0) {
      const hrs = Math.floor(overtimeMins / 60);
      const mins = overtimeMins % 60;
      const str = hrs > 0 ? `Godkänd övertid: +${hrs} tim ${mins > 0 ? mins + ' min' : ''}` : `Godkänd övertid: +${mins} min`;
      appendReasonTag(str);
    } else {
      appendReasonTag('Godkänd enligt ordinarie schema');
    }
  }

  // Append a reason tag to adminNote
  function appendReasonTag(tag) {
    const noteEl = document.getElementById('editAdminNote');
    if (!noteEl) return;
    let current = noteEl.value.trim();
    if (!current) {
      noteEl.value = tag;
    } else if (!current.includes(tag)) {
      noteEl.value = current + ' | ' + tag;
    }
    noteEl.focus();
  }

  function revertToOriginalTimes() {
    if (!currentEditingEntry) return;
    const origIn = currentEditingEntry.originalCheckInTimeStr || currentEditingEntry.checkInTimeStr;
    const origOut = currentEditingEntry.originalCheckOutTimeStr || currentEditingEntry.checkOutTimeStr;
    const origStart = currentEditingEntry.originalPlannedStartTime || currentEditingEntry.plannedStartTime;
    const origEnd = currentEditingEntry.originalPlannedEndTime || currentEditingEntry.plannedEndTime;

    if (origIn && origIn !== '–') document.getElementById('editCheckIn').value = origIn;
    if (origOut && origOut !== '–' && origOut !== 'Pågående...') document.getElementById('editCheckOut').value = origOut;
    if (origStart) document.getElementById('editPlannedStart').value = origStart;
    if (origEnd) document.getElementById('editPlannedEnd').value = origEnd;
    updateModalLiveCalc();
  }

  function closeEditPunchModal() {
    document.getElementById('editPunchModal').classList.add('hidden');
  }

  // Stäng aktiva modaler med Escape-tangenten
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeEditPunchModal();
      closeManualPunchModal();
      closeQuickClockOutModal();
      closeDeletePunchModal();
    }
  });

  // Delete Punch Confirmation Modal handlers
  function openConfirmDeletePunchModal(punchId, detailsText) {
    const modal = document.getElementById('deletePunchModal');
    const form = document.getElementById('deletePunchForm');
    const text = document.getElementById('deletePunchDetailsText');
    if (form) form.action = `/admin/stampling/delete/${punchId}`;
    if (text) text.textContent = detailsText || 'personalens stämpling';
    if (modal) modal.classList.remove('hidden');
  }

  function closeDeletePunchModal() {
    const modal = document.getElementById('deletePunchModal');
    if (modal) modal.classList.add('hidden');
  }

  function triggerDeleteCurrentPunch() {
    if (!currentEditingEntry) return;
    const punchId = currentEditingEntry.id;
    const details = `${currentEditingEntry.fullName || 'Personal'} (${currentEditingEntry.date || ''})`;
    closeEditPunchModal();
    openConfirmDeletePunchModal(punchId, details);
  }

  // Quick Clock Out Modal
  function openQuickClockOutModal(id, staffName) {
    const form = document.getElementById('quickClockOutForm');
    form.action = '/admin/stampling/out/' + id;
    document.getElementById('quickClockOutStaffName').textContent = staffName;

    const now = new Date();
    const h = String(now.getHours()).padStart(2, '0');
    const m = String(now.getMinutes()).padStart(2, '0');
    document.getElementById('quickCheckOutTime').value = `${h}:${m}`;

    document.getElementById('quickClockOutModal').classList.remove('hidden');
  }
  function closeQuickClockOutModal() {
    document.getElementById('quickClockOutModal').classList.add('hidden');
  }
</script>

<!-- Delete Punch Confirmation Modal -->
