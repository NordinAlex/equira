<!-- Time and place card-->
<div class="m-6 bg-white border border-[#B0A696] rounded-xl">

  <!-- Top block -->
  <div class="p-6 flex gap-8 border-b border-[#F2EFEB]">
    <i class="fa-regular fa-calendar text-3xl self-center bg-[#F2EFEB] p-4 rounded-full"></i>
    <div class="flex flex-col">
      <h3 class="font-semibold text-equira-cognac-800">DATUM & TID</h3>
      <p class="text-lg">
        <%= new Date(`${lesson.date}T00:00:00`).toLocaleDateString("sv-SE", {
            weekday: "long",
            day: "numeric",
            month: "short"
        }).replace(".", "").replace(/^./, char => char.toUpperCase()) %>
      </p>
      <p class="text-lg text-equira-cognac-800"><%= lesson.startTime %> - <%= lesson.endTime %></p>
    </div>
  </div>

  <!-- Bottom block -->
  <div class="p-6 flex gap-8">
    <i class="fa-regular fa-map text-3xl self-center bg-[#F2EFEB] p-4 rounded-full"></i>
    <div class="flex flex-col">
      <h3 class="font-semibold text-equira-cognac-800">PLATS</h3>
      <p class="text-lg text-equira-cognac-800"><%= lesson.arena.name %></p>
    </div>
  </div>
</div>

<!-- Instructor and horse card-->
<div class="m-6 bg-white border border-[#B0A696] rounded-xl">
  <div class="flex p-6 gap-8">
    <i class="fa-regular fa-circle-user text-3xl self-center bg-[#F2EFEB] p-4 rounded-full"></i>
    <div class="flex flex-col">
      <h3 class="font-semibold text-equira-cognac-800">INSTRUKTÖR</h3>
      <p class="text-lg text-equira-cognac-800"><%= lesson.instructor.fullName %></p>
    </div>
  </div>

  <div>
    <% if (booking.horse) { %>
  <a href="/student/horses/<%= booking.horse.id %>" class="flex gap-5 justify-between mx-6 mb-6 bg-[#F2EFEB] border border-[#B0A696] rounded-md p-3">
    <i class="fa-solid fa-horse-head p-3 text-3xl self-center text-equira-cognac-800"></i>

    <div class="flex flex-col">
      <h3 class="font-semibold text-equira-cognac-800">Tilldelad häst</h3>
      <p class="text-lg font-semibold"><%= booking.horse.name %></p>
    </div>

    <i class="fa-solid fa-arrow-right text-xl ml-auto self-center p-3 text-equira-cognac-800"></i>
  </a>
<% } else { %>
  <div class="flex gap-5 mx-6 mb-6 bg-[#F2EFEB] border border-[#B0A696] rounded-md p-3">
    <i class="fa-solid fa-horse-head p-3 text-3xl self-center text-equira-cognac-800"></i>

    <div class="flex flex-col">
      <h3 class="font-semibold text-equira-cognac-800">Tilldelad häst</h3>
      <p class="text-lg font-semibold">Ej tilldelad än</p>
    </div>
  </div>
<% } %>
  </div>
</div>