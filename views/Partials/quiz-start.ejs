<div id="quiz-start">

  <div class="mx-6 flex flex-col gap-2 h-screen justify-around">
    <div>
      <h1 class="text-3xl font-semibold text-center"><%= quiz.title %></h1>
      <p class="text-lg font-semibold text-center text-equira-cognac-600 my-6"><%= quiz.questions.length %> frågor</p>
    </div>

    <div class="flex justify-center">
      <button type="button" id="start-quiz" class="bg-equira-cognac-600 text-white text-xl font-semibold rounded-full py-6 px-18 drop-shadow-lg cursor-pointer">
        STARTA QUIZ
      </button>
    </div>
  </div>

</div>