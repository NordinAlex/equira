<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

<div class="flex items-center justify-between border-b bg-[#f5f0eb] px-6 py-3 sticky top-0 z-10">

  
  <div class="flex items-center gap-3">
    <h1 style="font-family: 'Playfair Display', serif;" class="text-xl text-gray-900 font-semibold tracking-wide">
      <%= typeof title !== 'undefined' ? title : 'Equira' %>
    </h1>
  </div>

  
  <div class="flex items-center gap-3">

   
    <form action="/search" method="GET">
      <div class="relative hidden md:block">
        <input type="search" name="q" placeholder="Sök..."
          class="rounded-xl border bg-gray-50 py-2 pl-9 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-[#2c1a0e]/20" />
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
      </div>
    </form>

    <button class="relative text-gray-400 hover:text-gray-600 p-2 rounded-xl hover:bg-gray-100">
      <i class="fa-regular fa-bell text-lg"></i>
      <span class="absolute top-1 right-1 w-2 h-2 bg-red-500 rounded-full"></span>
    </button>

  </div>
</div>