<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/stylesheets/styles.css" />   
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon" />
    <title>Equira | Logga in</title>
</head>

<body>
    <header class="relative h-65 overflow-hidden">
        <img src="/images/login-background.jpg" alt="Häst" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent to-white"></div>
    </header>

    <!-- Login -->
    <main>
        <div class="flex flex-col items-center gap-3">
            <h1 class="text-3xl font-semibold">Equira</h1>
            <h2 class="text-lg">Välkommen tillbaka</h2>
        </div>

        <!-- Username input -->
        <form action="/login" method="POST" class="flex flex-col
        m-12
        gap-5">
            <div class="flex flex-col gap-2">
                <label for="username" class="font-semibold">Användarnamn</label>
                <div class="relative">
                    <svg class="absolute left-2 top-1/2 -translate-y-1/2 w-5 h-5 text-[#8C806E]"
                        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.25a8.25 8.25 0 0 1 15 0" />
                    </svg>
                    <input placeholder="Användarnamn" type="text" id="username" name="username" required
                        class="w-full pl-8 bg-[#FAF7F2] border border-[#ECE2CF] h-10 rounded autofill:bg-[#FAF7F2]">
                </div>
            </div>

            <!-- Password input -->
            <div class="flex flex-col gap-2">
                <label for="password" class="font-semibold">Lösenord</label>
                <div class="relative">
                    <svg class="absolute left-2 top-1/2 -translate-y-1/2 w-5 h-5 text-[#8C806E]"
                        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M16.5 10.5V7.5a4.5 4.5 0 0 0-9 0v3M6 10.5h12a1.5 1.5 0 0 1 1.5 1.5v7.5A1.5 1.5 0 0 1 18 21H6a1.5 1.5 0 0 1-1.5-1.5V12A1.5 1.5 0 0 1 6 10.5Z" />
                    </svg>
                    <input placeholder="Lösenord" type="password" id="password" name="password" required
                        class="w-full pl-8 bg-[#FAF7F2] border border-[#ECE2CF] h-10 rounded autofill:bg-[#FAF7F2]">
                </div>
            </div>

            <!-- Remember me toggle -->
            <div class="flex items-center justify-between">
                <label for="remember" class="font-semibold">Kom ihåg mig</label>

                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="remember" name="remember"  value="1" class="sr-only peer">
                    <div class="w-11 h-6 bg-[#ECE2CF] rounded-full peer
                    peer-checked:bg-[#4A3226]
                    after:content-[''] after:absolute after:top-[2px] after:left-[2px]
                    after:bg-white after:rounded-full after:h-5 after:w-5
                    after:transition-all
                    peer-checked:after:translate-x-full">
                    </div>
                </label>
            </div>

            <button type="submit"
            class="bg-[#4A3226] text-white px-8 py-3 rounded font-semibold cursor-pointer mt-4">Logga in</button>
        </form>

        <p class="text-center">Inget konto? <span class="font-semibold">Kontakta administratör.</span></p>
        <a href="#"
        class="block text-center mt-2 font-semibold underline text-[#4A3226]">Glömt lösenord?</a>
    </main>

</body>

</html>