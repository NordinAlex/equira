<!DOCTYPE html>
<html lang="sv" class="h-full bg-stone-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Equira - Installation & Skapa administratör' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            equira: {
              green: {
                950: '#0f241a',
                900: '#142e21',
                800: '#1B3B2B',
                700: '#25523d',
                600: '#326a4f',
                100: '#e3efe7',
                50: '#f0f7f3',
              },
              cognac: {
                900: '#2a160d',
                800: '#3d2314',
                700: '#4a2828',
                600: '#5c3528',
              },
              sand: {
                50: '#fdfbf7',
                100: '#f7f4ed',
                200: '#ede8dd',
              }
            }
          }
        }
      }
    }
  </script>
</head>
<body class="min-h-full bg-[#f4f2ee] flex items-center justify-center p-0 lg:p-6 text-stone-800 antialiased">

  <!-- Responsive Container: Split Screen on Desktop, Card on Mobile -->
  <div class="w-full h-full lg:h-auto lg:max-w-6xl bg-white lg:rounded-3xl lg:shadow-2xl overflow-hidden border-0 lg:border border-stone-200 grid grid-cols-1 lg:grid-cols-12 min-h-screen lg:min-h-[720px]">
    
    <!-- LEFT COLUMN: Stable Imagery & System Setup Overview (Visible on lg+) -->
    <div class="hidden lg:flex lg:col-span-5 relative bg-stone-900 overflow-hidden flex-col justify-between p-8 text-white">
      <img src="/images/stable.jpg" alt="Equira Ridcenter" class="absolute inset-0 w-full h-full object-cover opacity-35 scale-105 transition duration-700 hover:scale-100">
      <div class="absolute inset-0 bg-gradient-to-t from-[#0f241a] via-[#142e21]/80 to-[#1B3B2B]/90"></div>
      
      <!-- Top Brand in Left Column -->
      <div class="relative z-10">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-2xl bg-white/15 backdrop-blur-md text-emerald-300 flex items-center justify-center border border-white/20 shadow-md">
            <i class="fa-solid fa-horseshoe text-lg"></i>
          </div>
          <div>
            <span class="text-2xl font-bold tracking-tight text-white block leading-tight">Equira</span>
            <span class="text-[10px] tracking-widest text-emerald-300 uppercase font-semibold">Ridcenter & Stallhantering</span>
          </div>
        </div>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-200 text-xs font-medium mb-4 backdrop-blur-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Systeminstallation aktiv</span>
        </div>

        <h2 class="text-xl font-bold text-white tracking-tight mb-2">Initiering av ridskolesystem</h2>
        <p class="text-xs text-stone-300 leading-relaxed">
          Databasen är ren och har inga befintliga användarkonton. Den användare du skapar nu blir systemets första huvudadministratör med obegränsad behörighet.
        </p>
      </div>

      <!-- Installation Steps Visual Timeline -->
      <div class="relative z-10 space-y-4 my-8">
        <div class="flex items-start gap-3">
          <div class="w-7 h-7 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs font-bold shrink-0 shadow-xs">
            <i class="fa-solid fa-check text-[11px]"></i>
          </div>
          <div>
            <p class="text-xs font-semibold text-white">1. Databasschema synkroniserat</p>
            <p class="text-[11px] text-stone-300">Tabeller för hästar, lektioner och ridhus är klara.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <div class="w-7 h-7 rounded-full bg-emerald-400 text-stone-900 flex items-center justify-center text-xs font-bold shrink-0 ring-4 ring-emerald-500/30">
            2
          </div>
          <div>
            <p class="text-xs font-semibold text-emerald-200">2. Skapa huvudadministratör (ADMIN)</p>
            <p class="text-[11px] text-emerald-300/80">Registrera huvudkontot med full behörighet.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 opacity-60">
          <div class="w-7 h-7 rounded-full bg-white/10 text-white flex items-center justify-center text-xs font-bold shrink-0">
            3
          </div>
          <div>
            <p class="text-xs font-semibold text-stone-300">3. Välkommen till administrationsportalen</p>
            <p class="text-[11px] text-stone-400">Automatisk inloggning och översikt.</p>
          </div>
        </div>
      </div>

      <!-- Bottom Security Notice -->
      <div class="relative z-10 p-3.5 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15">
        <div class="flex items-center gap-2 text-emerald-300 text-xs font-semibold mb-1">
          <i class="fa-solid fa-shield-halved"></i>
          <span>Säkerhetslås</span>
        </div>
        <p class="text-[11px] text-stone-300 leading-snug">
          Så fort administratörskontot har skapats stängs installationssidan permanent och kan inte nås igen.
        </p>
      </div>

    </div>

    <!-- RIGHT COLUMN: Registration Form -->
    <div class="col-span-1 lg:col-span-7 flex flex-col justify-center px-6 sm:px-12 py-8 lg:py-10 bg-white relative overflow-y-auto">
      
      <!-- Mobile Banner (Small screens only) -->
      <div class="block lg:hidden -mx-6 -mt-8 mb-6 h-36 relative overflow-hidden bg-stone-900">
        <img src="/images/stable.jpg" alt="Equira" class="w-full h-full object-cover opacity-40">
        <div class="absolute inset-0 bg-gradient-to-t from-white via-white/50 to-transparent"></div>
        <div class="absolute top-4 left-6 right-6 flex items-center justify-between text-white">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-white/20 flex items-center justify-center">
              <i class="fa-solid fa-horseshoe text-xs text-emerald-300"></i>
            </div>
            <span class="font-bold text-lg">Equira</span>
          </div>
          <span class="px-2.5 py-1 rounded-full bg-emerald-500/80 text-[10px] font-bold uppercase tracking-wider">Installation</span>
        </div>
      </div>

      <!-- Header -->
      <div class="mb-6">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-2 border border-emerald-200">
          <i class="fa-solid fa-crown text-emerald-600"></i>
          <span>Första användare &bull; Huvudadministratör</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight">Skapa administratörskonto</h1>
        <p class="text-xs sm:text-sm text-stone-500 font-normal mt-1 leading-relaxed">
          Det finns inga användare i databasen. Skapa systemets huvudadministratör för att konfigurera och leda ridskolan.
        </p>
      </div>

      <!-- Error Alert -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-5 p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs rounded-2xl flex items-start gap-3 shadow-xs">
          <i class="fa-solid fa-circle-exclamation text-rose-600 text-base mt-0.5 shrink-0"></i>
          <div>
            <p class="font-bold">Registreringen misslyckades</p>
            <p class="mt-0.5 text-rose-700"><%= error %></p>
          </div>
        </div>
      <% } %>

      <!-- Form -->
      <form action="/install" method="POST" class="space-y-4" id="installForm">
        
        <!-- Two-column row: Full Name & Username -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Full Name -->
          <div>
            <label class="block text-xs font-bold text-stone-700 uppercase tracking-wider mb-1.5">
              Fullständigt namn <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
                <i class="fa-regular fa-user text-sm"></i>
              </span>
              <input type="text" name="fullName" required autofocus
                value="<%= typeof formData !== 'undefined' && formData.fullName ? formData.fullName : '' %>"
                placeholder="t.ex. Emma Andersson"
                class="w-full pl-10 pr-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#1B3B2B] focus:bg-white transition text-stone-900 placeholder:text-stone-400">
            </div>
          </div>

          <!-- Username -->
          <div>
            <label class="block text-xs font-bold text-stone-700 uppercase tracking-wider mb-1.5">
              Användarnamn <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
                <i class="fa-solid fa-at text-sm"></i>
              </span>
              <input type="text" name="username" required
                value="<%= typeof formData !== 'undefined' && formData.username ? formData.username : 'admin' %>"
                placeholder="admin"
                class="w-full pl-10 pr-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#1B3B2B] focus:bg-white transition text-stone-900 placeholder:text-stone-400">
            </div>
          </div>
        </div>

        <!-- Two-column row: Email & Phone -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Email -->
          <div>
            <label class="block text-xs font-bold text-stone-700 uppercase tracking-wider mb-1.5">
              E-postadress <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
                <i class="fa-regular fa-envelope text-sm"></i>
              </span>
              <input type="email" name="email" required
                value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                placeholder="admin@equira.se"
                class="w-full pl-10 pr-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#1B3B2B] focus:bg-white transition text-stone-900 placeholder:text-stone-400">
            </div>
          </div>

          <!-- Phone -->
          <div>
            <label class="block text-xs font-bold text-stone-700 uppercase tracking-wider mb-1.5">
              Telefonnummer
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
                <i class="fa-solid fa-phone text-sm"></i>
              </span>
              <input type="tel" name="phone"
                value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
                placeholder="070-111 22 33"
                class="w-full pl-10 pr-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#1B3B2B] focus:bg-white transition text-stone-900 placeholder:text-stone-400">
            </div>
          </div>
        </div>

        <!-- Administrator Title -->
        <div>
          <label class="block text-xs font-bold text-stone-700 uppercase tracking-wider mb-1.5">
            Titel / Befattning i stallet
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
              <i class="fa-solid fa-id-badge text-sm"></i>
            </span>
            <input type="text" name="title"
              value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : 'Ridskolechef & Huvudinstruktör' %>"
              placeholder="t.ex. Ridskolechef & Huvudinstruktör"
              class="w-full pl-10 pr-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#1B3B2B] focus:bg-white transition text-stone-900 placeholder:text-stone-400">
          </div>
          <p class="text-[11px] text-stone-400 mt-1">Visas i personalöversikten och på instruktörsscheman.</p>
        </div>

        <!-- Passwords (Two-column) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
          <!-- Password -->
          <div>
            <label class="block text-xs font-bold text-stone-700 uppercase tracking-wider mb-1.5">
              Lösenord <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
                <i class="fa-solid fa-lock text-sm"></i>
              </span>
              <input type="password" id="password" name="password" required minlength="6" placeholder="Minst 6 tecken"
                class="w-full pl-10 pr-10 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#1B3B2B] focus:bg-white transition text-stone-900 placeholder:text-stone-400">
              <button type="button" onclick="togglePasswordVisibility('password', this)" class="absolute inset-y-0 right-0 pr-3 flex items-center text-stone-400 hover:text-stone-600 focus:outline-none">
                <i class="fa-regular fa-eye text-sm"></i>
              </button>
            </div>
          </div>

          <!-- Confirm Password -->
          <div>
            <label class="block text-xs font-bold text-stone-700 uppercase tracking-wider mb-1.5">
              Bekräfta lösenord <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
                <i class="fa-solid fa-lock text-sm"></i>
              </span>
              <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" placeholder="Upprepa lösenord"
                class="w-full pl-10 pr-10 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#1B3B2B] focus:bg-white transition text-stone-900 placeholder:text-stone-400">
              <button type="button" onclick="togglePasswordVisibility('confirmPassword', this)" class="absolute inset-y-0 right-0 pr-3 flex items-center text-stone-400 hover:text-stone-600 focus:outline-none">
                <i class="fa-regular fa-eye text-sm"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- Optional Checklist: Seed Basic Arenas -->
        <div class="p-3.5 bg-stone-50 border border-stone-200 rounded-2xl">
          <label class="flex items-start gap-3 cursor-pointer select-none">
            <input type="checkbox" name="seedBasicArenas" value="1" checked
              class="w-4 h-4 mt-0.5 rounded text-[#1B3B2B] border-stone-300 focus:ring-[#1B3B2B]">
            <div>
              <span class="text-xs font-bold text-stone-800 block">Initiera ridhus och ridbanor automatiskt</span>
              <span class="text-[11px] text-stone-500 block leading-tight mt-0.5">
                Skapar Stora Ridhuset (20×60m), Lilla Ridhuset (20×40m) och Utebanan så att ridskolan är redo för schema och lektioner.
              </span>
            </div>
          </label>
        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <button type="submit"
            class="w-full py-3.5 px-6 bg-[#1B3B2B] hover:bg-[#142e21] text-white font-bold rounded-xl shadow-md hover:shadow-lg flex items-center justify-center gap-2.5 transition transform active:scale-[0.99] text-sm group">
            <i class="fa-solid fa-crown text-emerald-300 group-hover:rotate-12 transition"></i>
            <span>Slutför installation & Logga in som Admin</span>
            <i class="fa-solid fa-arrow-right text-xs transition group-hover:translate-x-1"></i>
          </button>
        </div>

      </form>

      <!-- System Environment Badge Footer -->
      <div class="mt-8 pt-4 border-t border-stone-100 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-stone-400">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Equira Riding Management Platform v1.0</span>
        </div>
        <div class="flex items-center gap-3">
          <span>TypeORM SQLite</span>
          <span>&bull;</span>
          <span>Roll: ADMIN</span>
        </div>
      </div>

    </div>
  </div>

  <script>
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }

    // Client-side quick password match validation
    document.getElementById('installForm').addEventListener('submit', function(e) {
      const pw = document.getElementById('password').value;
      const cpw = document.getElementById('confirmPassword').value;
      if (pw !== cpw) {
        e.preventDefault();
        alert('Lösenorden matchar inte! Kontrollera båda fälten.');
      }
    });
  </script>

</body>
</html>
