<!DOCTYPE html>
<html lang="sv">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Equira | Lektionsdetaljer</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/stylesheets/styles.css" />
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon" />
</head>

<body class="bg-[#F2EFEB]">
  <header class="mb-26">
    <%-include('../Partials/topbar-student.ejs')%>
  </header>

  <main>
    <!-- Title -->
    <div class="mx-6 flex gap-2 w-fit bg-equira-green-100 text-equira-green-700 font-semibold p-3 rounded-full">
      <i class="fa-solid fa-flag self-center"></i>
      <p><%= lesson.lessonType %></p>
    </div>

    <h1 class="p-6 text-3xl font-semibold"><%= lesson.title %></h1>
    <p class="px-6 text-xl"><%= lesson.description %></p>

    <!-- Lesson details card-->
    <div>
      <%-include('../Partials/lesson-details-card.ejs')%>
    </div>

    <!-- Before the lesson info -->
    <div class="mx-6 my-15 p-6 flex flex-col gap-6 bg-equira-sand-200 border border-[#B0A696] rounded-xl">
      <div class="flex gap-3">
        <i class="fa-solid fa-circle-info text-3xl text-equira-cognac-600 self-center"></i>
        <h2 class="text-xl text-equira-cognac-600 font-semibold">Inför lektionen</h2>
      </div>

      <!-- List -->
      <div class="flex flex-col gap-3">
        <div class="flex gap-3">
          <i class="fa-regular fa-circle-check text-2xl text-equira-cognac-600 self-center"></i>
          <p class="text-lg text-equira-cognac-600">Var på plats minst 30 minuter innan
            lektionsstart för att göra i ordning
            hästen.</p>
        </div>

        <div class="flex gap-3">
          <i class="fa-regular fa-circle-check text-2xl text-equira-cognac-600 self-center"></i>
          <p class="text-lg text-equira-cognac-600">Borsta noggrant och visitera benen
            före sadling.</p>
        </div>
      </div>
    </div>

  </main>
</body>

</html>