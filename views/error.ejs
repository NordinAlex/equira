<!DOCTYPE html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= error?.status || 500 %> | Equira</title>
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="/stylesheets/styles.css" />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-stone-100 px-4 py-8 text-stone-900">
    <main class="w-full max-w-xl rounded-3xl border border-stone-200 bg-white px-6 py-12 text-center shadow-xl shadow-stone-900/10 sm:px-12">
      <p class="mb-6 text-sm font-bold uppercase tracking-[0.18em] text-emerald-800">Equira</p>
      <h1 class="text-7xl font-bold leading-none tracking-tight text-[#1B3B2B] sm:text-8xl"><%= error?.status || 500 %></h1>
      <h2 class="mt-6 text-2xl font-semibold text-stone-900 sm:text-3xl"><%= message || 'Något gick fel' %></h2>
      <p class="mx-auto mt-3 max-w-prose text-sm leading-6 text-stone-600 sm:text-base">Sidan du försökte öppna kunde inte hittas.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/" class="inline-flex items-center justify-center rounded-xl bg-[#3d2314] px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#2a170c] focus:outline-none focus:ring-2 focus:ring-[#3d2314] focus:ring-offset-2">Till startsidan</a>
      <% if (currentUser) { %>
        <form action="/logout" method="POST">
          <button type="submit" class="inline-flex items-center justify-center rounded-xl border border-stone-300 bg-white px-5 py-3 text-sm font-semibold text-stone-700 shadow-sm transition hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-400 focus:ring-offset-2">Logga ut</button>
        </form>
      <% } %>
      </div>
    </main>
  </body>
</html>
