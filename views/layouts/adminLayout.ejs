        <a href="/admin/overview" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center border border-white/20 group-hover:bg-white/20 transition">
            <i class="fa-solid fa-horse-head text-emerald-300 text-xl"></i>
          </div>
          <div>
            <h1 class="font-bold text-2xl tracking-tight text-white">Equira</h1>
            <p class="text-[10px] tracking-widest text-emerald-300 uppercase font-medium">Ridskolesystem</p>
          </div>
        </a>
      </div>

    

      <!-- Navigation Links -->
      <nav class="p-4 space-y-1 text-sm font-medium">
