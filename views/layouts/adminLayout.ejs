        <a href="/admin/profile" class="flex items-center gap-3 group min-w-0 flex-1 hover:opacity-90 transition">
          <img src="<%= (currentUser && currentUser.avatarUrl) ? currentUser.avatarUrl : '/images/default-staff.jpg' %>" alt="Admin" class="w-10 h-10 rounded-full object-cover border border-white/20 group-hover:border-emerald-400 transition">
          <div class="overflow-hidden">
            <p class="text-sm font-semibold text-white truncate group-hover:text-emerald-200 transition"><%= currentUser ? currentUser.fullName : 'Admin' %></p>
            <p class="text-xs text-emerald-300 truncate">Riding School Admin</p>
          </div>
        </a>
        <a href="/logout" title="Logga ut" class="p-2 text-emerald-300 hover:text-white hover:bg-white/10 rounded-lg transition shrink-0 ml-2">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </a>
      </div>
    </div>
  </aside>

